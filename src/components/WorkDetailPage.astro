---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceVisual from "./ServiceVisual.astro";
import site from "../data/site.json";
import workData from "../data/work-details/acecore-site-platform.json";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, htmlLangMap, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

type WorkDetail = typeof workData;

interface Props {
  data: WorkDetail;
  canonicalPath: string;
  locale?: Locale;
}

const { data, canonicalPath: canonicalInput, locale = "ja" } = Astro.props;
const content = getLocalizedContent(locale);
const { siteFunctions, siteQuality, operations } = content.serviceDetails;
const text = getUi(locale);
const canonicalPath = getLocalizedUrl(canonicalInput, locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
const pageUrl = new URL(canonicalPath, site.siteUrl).href;
const workEntityId = `${pageUrl}#case-study`;
const organizationId = `${new URL("/", site.acecoreUrl).href}#organization`;
const relatedServices = [
  {
    href: getLocalizedUrl("/services/site-functions/", locale),
    title: siteFunctions.title,
  },
  {
    href: getLocalizedUrl("/services/site-quality/", locale),
    title: siteQuality.title,
  },
  {
    href: getLocalizedUrl("/services/operations/", locale),
    title: operations.title,
  },
];
const contactHref = `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams(
  {
    category: "service",
    service: "site-functions",
    from: "systems-work-acecore-site-platform",
    entry: "work-detail-cta",
  },
).toString()}`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": workEntityId,
    name: data.title,
    url: pageUrl,
    description: data.description,
    inLanguage: htmlLangMap[locale],
    genre: data.category,
    creator: { "@id": organizationId },
    about: data.scope.map((item) => item.title),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: text.home,
        item: new URL(getLocalizedUrl("/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: text.works,
        item: new URL(getLocalizedUrl("/works/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: data.title,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={workEntityId}
  bodyClass="work-detail-page"
  locale={locale}
>
  <section class="page-hero page-hero--detail">
    <div class="container page-hero__inner work-detail-hero__inner">
      <nav class="breadcrumb" aria-label={text.breadcrumbNavigation}>
        <ol>
          <li><a href={getLocalizedUrl("/", locale)}>{text.home}</a></li>
          <li><a href={getLocalizedUrl("/works/", locale)}>{text.works}</a></li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>
      <p class="page-eyebrow">{data.heroEyebrow}</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section class="work-detail-visual" aria-label={data.visual.alt}>
    <div class="container">
      <ServiceVisual {...data.visual} variant="section" />
    </div>
  </section>

  <section
    id="work-overview"
    class="page-section work-detail-overview"
    aria-labelledby="work-overview-title"
  >
    <div class="container">
      <div class="work-detail-overview__layout">
        <header class="editorial-header">
          <p class="editorial-eyebrow">{text.overview} / 01</p>
          <h2 id="work-overview-title">{data.overviewTitle}</h2>
          <p>{data.overviewBody}</p>
        </header>
        <dl class="work-detail-facts">
          {
            data.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="work-detail-outcomes">
        <header class="work-detail-outcomes__header">
          <p class="editorial-eyebrow">{text.currentState}</p>
          <h3>{data.outcomesTitle}</h3>
        </header>
        <ul>
          {
            data.outcomes.map((outcome) => (
              <li>
                <p>{outcome.label}</p>
                <p>{outcome.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <ServiceVisual {...data.outcomesVisual} variant="section" />
    </div>
  </section>

  <section
    id="work-story"
    class="page-section page-section--muted"
    aria-labelledby="work-story-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">{text.challengeAndPolicy} / 02</p>
        <h2 id="work-story-title">{text.sustainableShape}</h2>
      </header>
      <div class="work-story">
        {
          data.story.map((item) => (
            <article class="work-story__item">
              <p class="editorial-index">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="work-scope"
    class="page-section"
    aria-labelledby="work-scope-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">{text.implementationScope} / 03</p>
          <h2 id="work-scope-title">{data.scopeTitle}</h2>
        </div>
        <p>{data.scopeLead}</p>
      </header>
      <ServiceVisual {...data.scopeVisual} variant="section" />
      <div class="detail-offering-list">
        {
          data.scope.map((item, index) => (
            <article class="detail-offering">
              <header class="detail-offering__header">
                <p class="editorial-index">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3>{item.title}</h3>
              </header>
              <div class="detail-offering__body">
                <p>{item.body}</p>
                <ul class="service-points">
                  {item.items.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="page-section page-section--muted work-detail-next"
    aria-labelledby="work-related-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">{text.relatedSupport} / 04</p>
        <h2 id="work-related-title">{text.supportInThisCase}</h2>
      </header>
      <ul class="work-related-links">
        {
          relatedServices.map((service) => (
            <li>
              <a href={service.href}>
                <span>{service.title}</span>
                <span>{text.viewSupport} →</span>
              </a>
            </li>
          ))
        }
      </ul>
      <aside
        class="editorial-cta service-cta work-detail-next__cta"
        aria-labelledby="work-detail-cta-title"
      >
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Consultation</p>
          <h2 id="work-detail-cta-title">{data.ctaTitle}</h2>
          <p>{data.ctaBody}</p>
        </div>
        <a class="editorial-link editorial-link--primary" href={contactHref}>
          {text.similarPlatformConsultation}
        </a>
      </aside>
    </div>
  </section>

  <section
    id="work-resources"
    class="page-section work-detail-resources"
    aria-labelledby="work-resources-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">{text.technicalNotes} / 05</p>
          <h2 id="work-resources-title">{data.resourcesTitle}</h2>
        </div>
        <p>{data.resourcesLead}</p>
      </header>
      <div class="detail-resource-list">
        {
          data.resources.map((resource, index) => (
            <a class="detail-resource" href={localizeHref(resource.href)}>
              <p class="editorial-index">
                Note {String(index + 1).padStart(2, "0")}
              </p>
              <div>
                <h3>{resource.title}</h3>
                <p>{resource.description}</p>
              </div>
              <span>{text.readTechnicalNote}</span>
            </a>
          ))
        }
      </div>
      <div class="work-detail-external">
        <a
          class="editorial-link"
          href={new URL(getLocalizedUrl("/", locale), data.externalUrl).href}
        >
          {text.viewAcecoreSite}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
