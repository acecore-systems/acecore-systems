---
import site from "../data/site.json";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import PurposeIcon from "./PurposeIcon.astro";
import {
  getLocalizedUrl,
  htmlLangMap,
  localeLabels,
  locales,
  type Locale,
} from "../i18n";
import { getUi } from "../i18n/ui";
import { getLocalizedContent } from "../i18n/content";
import { getAvailableRouteLocales } from "../lib/insight-links.mjs";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = getUi(locale);
const content = getLocalizedContent(locale);
const currentPath = Astro.url.pathname;
const availableLocales = getAvailableRouteLocales(currentPath);
const contactHref = getLocalizedUrl("/contact/", locale);
const primaryNavPaths = new Set([
  "/services/",
  "/works/",
  "/pricing/",
  "/insights/",
]);
const desktopNav = content.site.nav
  .filter((item) => primaryNavPaths.has(item.href))
  .map((item) => ({ ...item, href: getLocalizedUrl(item.href, locale) }));
const nav = content.site.nav.map((item) => ({
  ...item,
  href: getLocalizedUrl(item.href, locale),
}));
const isCurrent = (href: string) =>
  !href.includes("#") &&
  (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand-cluster">
      <a
        class="brand"
        href={getLocalizedUrl("/", locale)}
        aria-label="Acecore Systems"
      >
        <img
          class="brand-logo"
          src="/favicon.svg"
          alt={`${site.name} ロゴ`}
          width="32"
          height="32"
        />
        <span class="brand-name">
          {site.name === "Acecore Systems" ? (
            <>
              <span class="brand-corporate-name">Acecore</span>{" "}
              <span class="brand-service-name">Systems</span>
            </>
          ) : (
            site.name
          )}
        </span>
      </a>
      <a
        class="parent-brand-link"
        href={new URL(getLocalizedUrl("/", locale), site.acecoreUrl).href}
      >
        {text.officialSite}
      </a>
    </div>
    <nav class="nav desktop-nav" aria-label={text.mainNavigation}>
      {desktopNav.map((item) => (
        <a
          href={item.href}
          aria-current={
            isCurrent(item.href)
              ? currentPath === item.href
                ? "page"
                : "location"
              : undefined
          }
        >
          {item.label}
        </a>
      ))}
    </nav>
    <LanguageSwitcher locale={locale} />
    <div class="header-actions">
      {locale === "ja" && (
        <button
          class="header-search"
          type="button"
          aria-haspopup="dialog"
          aria-controls="site-search-dialog"
          data-search-open
        >
          <PurposeIcon name="search" />
          <span class="visually-hidden">検索</span>
        </button>
      )}
      <a
        class="header-cta"
        href={contactHref}
        aria-current={currentPath.startsWith(contactHref) ? "page" : undefined}
      >
        {text.purposeContact}
      </a>
    </div>
    <details class="mobile-menu">
      <summary>{text.menu}</summary>
      <nav aria-label={text.mobileNavigation}>
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={
              isCurrent(item.href)
                ? currentPath === item.href
                  ? "page"
                  : "location"
                : undefined
            }
          >
            {item.label}
          </a>
        ))}
        {locale === "ja" && (
          <button
            class="mobile-menu__search"
            type="button"
            aria-haspopup="dialog"
            aria-controls="site-search-dialog"
            data-search-open
          >
            サイト内を検索
          </button>
        )}
        <a
          class="mobile-menu__cta"
          href={contactHref}
          aria-current={
            currentPath.startsWith(contactHref) ? "page" : undefined
          }
        >
          {text.contact}
        </a>
        <div class="mobile-language-links" aria-label={text.languageSelector}>
          {locales
            .filter((targetLocale) => availableLocales.includes(targetLocale))
            .map((targetLocale) => (
              <a
                href={getLocalizedUrl(currentPath, targetLocale)}
                lang={htmlLangMap[targetLocale]}
                hreflang={htmlLangMap[targetLocale]}
                aria-current={targetLocale === locale ? "page" : undefined}
              >
                {localeLabels[targetLocale]}
              </a>
            ))}
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(
    ".mobile-menu, .language-switcher",
  );
  const closeMenus = () => menus.forEach((menu) => (menu.open = false));
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    ".mobile-menu",
  )) {
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    }
  }
  for (const menu of menus) {
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        event.preventDefault();
        event.stopPropagation();
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (event.target instanceof Node && !menu.contains(event.target))
        menu.open = false;
    }
  });
  window
    .matchMedia("(min-width: 1400px)")
    .addEventListener("change", closeMenus);
</script>
