---
import site from '../data/site.json'

const currentPath = Astro.url.pathname
const isCurrent = (href: string) =>
  href.startsWith('/#') ? currentPath === '/' : href !== '/' && currentPath.startsWith(href)
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Acecore Systems">
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="nav desktop-nav" aria-label="メインナビゲーション">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <details class="mobile-menu">
      <summary>メニュー</summary>
      <nav aria-label="モバイルナビゲーション">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-menu')) {
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => menu.removeAttribute('open'))
    }
  }
</script>
