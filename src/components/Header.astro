---
import site from "../data/site.json";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import {
  getLocalizedUrl,
  htmlLangMap,
  localeLabels,
  locales,
  type Locale,
} from "../i18n";
import { getUi } from "../i18n/ui";
import { getLocalizedContent } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = getUi(locale);
const content = getLocalizedContent(locale);
const currentPath = Astro.url.pathname;
const contactHref = getLocalizedUrl("/contact/", locale);
const nav = content.site.nav.map((item) => ({
  ...item,
  href: getLocalizedUrl(item.href, locale),
}));
const isCurrent = (href: string) =>
  !href.includes("#") &&
  (href === "/" ? currentPath === "/" : currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand-cluster">
      <a
        class="brand"
        href={getLocalizedUrl("/", locale)}
        aria-label="Acecore Systems"
      >
        <img
          class="brand-logo"
          src="/favicon.svg"
          alt=""
          width="32"
          height="32"
          aria-hidden="true"
        />
        <span class="brand-name">{site.name}</span>
      </a>
      <a
        class="parent-brand-link"
        href={new URL(getLocalizedUrl("/", locale), site.acecoreUrl).href}
        >{text.officialSite}</a
      >
    </div>
    <nav class="nav desktop-nav" aria-label={text.mainNavigation}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} />
    <div class="header-actions">
      {
        locale === "ja" && (
          <button
            class="header-search"
            type="button"
            aria-haspopup="dialog"
            aria-controls="site-search-dialog"
            data-search-open
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4 4" />
            </svg>
            <span>検索</span>
          </button>
        )
      }
      <a
        class="header-cta"
        href={contactHref}
        aria-current={currentPath.startsWith(contactHref) ? "page" : undefined}
      >
        {text.contact}
      </a>
    </div>
    <details class="mobile-menu">
      <summary>{text.menu}</summary>
      <nav aria-label={text.mobileNavigation}>
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        {
          locale === "ja" && (
            <button
              class="mobile-menu__search"
              type="button"
              aria-haspopup="dialog"
              aria-controls="site-search-dialog"
              data-search-open
            >
              サイト内を検索
            </button>
          )
        }
        <a
          class="mobile-menu__cta"
          href={contactHref}
          aria-current={currentPath.startsWith(contactHref)
            ? "page"
            : undefined}
        >
          {text.contact}
        </a>
        <div class="mobile-language-links" aria-label={text.languageSelector}>
          {
            locales.map((targetLocale) => (
              <a
                href={getLocalizedUrl(currentPath, targetLocale)}
                lang={htmlLangMap[targetLocale]}
                hreflang={htmlLangMap[targetLocale]}
                aria-current={targetLocale === locale ? "page" : undefined}
              >
                {localeLabels[targetLocale]}
              </a>
            ))
          }
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(
    ".mobile-menu",
  )) {
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => menu.removeAttribute("open"));
    }
  }
</script>
