---
import { render, type CollectionEntry } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import InsightFeatureBlocks from "./InsightFeatureBlocks.astro";
import site from "../data/site.json";
import {
  getLocalizedInsightHref,
  getInsightSlug,
} from "../lib/insight-links.mjs";
import { getLocalizedUrl, htmlLangMap, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import "../styles/insights.css";

interface Props {
  entry: CollectionEntry<"insights">;
  author?: CollectionEntry<"authors">["data"];
  locale: Locale;
}

const { entry, author, locale } = Astro.props;
const text = getUi(locale);
const localizedAuthor = locale === "ja" ? undefined : author?.i18n?.[locale];
const authorName = localizedAuthor?.name ?? author?.name ?? entry.data.author;
const authorBio = localizedAuthor?.bio ?? author?.bio;
const authorUrl = author?.url
  ? (() => {
      const url = new URL(author.url);
      if (url.origin === site.acecoreUrl) {
        return new URL(
          getLocalizedUrl(`${url.pathname}${url.search}${url.hash}`, locale),
          site.acecoreUrl,
        ).href;
      }
      return url.href;
    })()
  : undefined;
const { Content, headings } = await render(entry);
const slug = getInsightSlug(entry.id);
const canonicalPath = getLocalizedInsightHref(slug, locale);
const pageUrl = new URL(canonicalPath, site.siteUrl).href;
const articleEntityId = `${pageUrl}#article`;
const organizationId = `${new URL("/", site.acecoreUrl).href}#organization`;
const systemsServiceId = `${new URL(getLocalizedUrl("/", locale), site.siteUrl).href}#service`;
const webPageId = `${pageUrl}#webpage`;
const articleImage = entry.data.uploadedImage ?? entry.data.image;
const articleImageUrl = articleImage
  ? new URL(articleImage, site.siteUrl).href
  : undefined;
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(htmlLangMap[locale], {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "@id": articleEntityId,
    headline: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    mainEntityOfPage: { "@id": webPageId },
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.lastUpdated ?? entry.data.date).toISOString(),
    inLanguage: htmlLangMap[locale],
    author: {
      "@type": "Person",
      name: authorName,
      ...(authorUrl ? { url: authorUrl } : {}),
    },
    publisher: { "@id": organizationId },
    about: { "@id": systemsServiceId },
    ...(articleImageUrl ? { image: articleImageUrl } : {}),
    keywords: entry.data.tags?.join(", "),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: text.home,
        item: new URL(getLocalizedUrl("/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: text.insights,
        item: new URL(getLocalizedUrl("/insights/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: entry.data.title,
        item: pageUrl,
      },
    ],
  },
  ...(entry.data.faq
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "@id": `${pageUrl}#faq`,
          mainEntity: entry.data.faq.items.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={articleEntityId}
  bodyClass="insight-article-page"
  ogType="article"
  image={articleImage}
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={(entry.data.lastUpdated ?? entry.data.date).toISOString()}
  locale={locale}
>
  <article class="insight-article">
    <header class="insight-article__header">
      <div class="container insight-article__header-inner">
        <nav class="breadcrumb" aria-label={text.breadcrumbNavigation}>
          <ol>
            <li><a href={getLocalizedUrl("/", locale)}>{text.home}</a></li>
            <li>
              <a href={getLocalizedUrl("/insights/", locale)}>{text.insights}</a
              >
            </li>
            <li aria-current="page">{entry.data.title}</li>
          </ol>
        </nav>
        <p class="page-eyebrow">{text.insightsEyebrow}</p>
        <h1>{entry.data.title}</h1>
        <p class="insight-article__description">{entry.data.description}</p>
        <div class="insight-article__meta">
          <span>{authorName}</span>
          <time datetime={entry.data.date.toISOString()}>
            {text.published}
            {formatDate(entry.data.date)}
          </time>
          {
            entry.data.lastUpdated && (
              <time datetime={entry.data.lastUpdated.toISOString()}>
                {text.updated} {formatDate(entry.data.lastUpdated)}
              </time>
            )
          }
        </div>
        {
          entry.data.tags && (
            <ul class="insight-tags" aria-label={text.tags}>
              {entry.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        {
          articleImage && (
            <figure class="insight-article__cover" aria-hidden="true">
              <img
                src={articleImage}
                alt=""
                width="1600"
                height="900"
                decoding="async"
                fetchpriority="high"
              />
            </figure>
          )
        }
      </div>
    </header>

    <div class="container insight-article__layout">
      <div class="insight-article__main">
        <InsightFeatureBlocks
          callout={entry.data.callout}
          insightGrid={entry.data.insightGrid}
          placement="before"
          locale={locale}
        />

        {
          tocHeadings.length > 0 && (
            <details class="insight-toc">
              <summary>{text.tableOfContents}</summary>
              <ol>
                {tocHeadings.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="insight-prose">
          <Content />
        </div>

        <InsightFeatureBlocks
          processFigure={entry.data.processFigure}
          compareTable={entry.data.compareTable}
          checklist={entry.data.checklist}
          statBar={entry.data.statBar}
          linkCards={entry.data.linkCards}
          faq={entry.data.faq}
          placement="after"
          locale={locale}
        />

        {
          author && (
            <aside
              class="insight-author"
              aria-labelledby="insight-author-title"
            >
              <p class="editorial-eyebrow">Author</p>
              <h2 id="insight-author-title">{authorName}</h2>
              {authorBio && <p>{authorBio}</p>}
              {authorUrl && <a href={authorUrl}>{text.authorProfile}</a>}
            </aside>
          )
        }
      </div>
    </div>
  </article>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside class="editorial-cta" aria-labelledby="article-cta-title">
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Next step</p>
          <h2 id="article-cta-title">{text.nextStepTitle}</h2>
          <p>{text.nextStepBody}</p>
        </div>
        <div>
          <a class="editorial-link" href={getLocalizedUrl("/guide/", locale)}
            >{text.viewGuide}</a
          >
          <a
            class="editorial-link editorial-link--primary"
            href={`${getLocalizedUrl("/contact/", locale)}?category=service&from=systems-insight&entry=${slug}`}
          >
            {text.technicalConsultation}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
