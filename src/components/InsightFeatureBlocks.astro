---
import { resolveInsightHref } from "../lib/insight-links.mjs";
import type { Locale } from "../i18n";

interface Callout {
  type: "info" | "warning" | "tip" | "note";
  title?: string;
  text: string;
}

interface ProcessFigure {
  eyebrow?: string;
  title: string;
  description?: string;
  steps: {
    title: string;
    description: string;
    icon: string;
    accent?: "brand" | "emerald" | "amber" | "slate";
  }[];
}

interface CompareTable {
  title?: string;
  before: { label: string; items: string[] };
  after: { label: string; items: string[] };
}

interface Checklist {
  title?: string;
  items: { text: string; checked?: boolean }[];
}

interface InsightGrid {
  eyebrow?: string;
  title: string;
  description?: string;
  items: { title: string; description: string }[];
}

interface StatBar {
  items: {
    value: string;
    label: string;
    description?: string;
  }[];
}

interface LinkCard {
  href: string;
  title: string;
  description?: string;
}

interface Faq {
  title?: string;
  items: { question: string; answer: string }[];
}

interface Props {
  callout?: Callout;
  processFigure?: ProcessFigure;
  compareTable?: CompareTable;
  checklist?: Checklist;
  insightGrid?: InsightGrid;
  statBar?: StatBar;
  linkCards?: LinkCard[];
  faq?: Faq;
  placement: "before" | "after";
  locale: Locale;
}

const {
  callout,
  processFigure,
  compareTable,
  checklist,
  insightGrid,
  statBar,
  linkCards,
  faq,
  placement,
  locale,
} = Astro.props;
const labels: Record<
  Locale,
  {
    comparison: string;
    keyPoints: string;
    checklist: string;
    relatedPages: string;
    faq: string;
  }
> = {
  ja: {
    comparison: "比較",
    keyPoints: "要点",
    checklist: "確認項目",
    relatedPages: "関連するページ",
    faq: "よくある質問",
  },
  en: {
    comparison: "Comparison",
    keyPoints: "Key points",
    checklist: "Checklist",
    relatedPages: "Related pages",
    faq: "Frequently asked questions",
  },
  "zh-cn": {
    comparison: "对比",
    keyPoints: "要点",
    checklist: "检查清单",
    relatedPages: "相关页面",
    faq: "常见问题",
  },
  es: {
    comparison: "Comparación",
    keyPoints: "Puntos clave",
    checklist: "Lista de comprobación",
    relatedPages: "Páginas relacionadas",
    faq: "Preguntas frecuentes",
  },
  pt: {
    comparison: "Comparação",
    keyPoints: "Pontos principais",
    checklist: "Lista de verificação",
    relatedPages: "Páginas relacionadas",
    faq: "Perguntas frequentes",
  },
  fr: {
    comparison: "Comparaison",
    keyPoints: "Points clés",
    checklist: "Liste de contrôle",
    relatedPages: "Pages associées",
    faq: "Questions fréquentes",
  },
  ko: {
    comparison: "비교",
    keyPoints: "핵심 사항",
    checklist: "확인 항목",
    relatedPages: "관련 페이지",
    faq: "자주 묻는 질문",
  },
  de: {
    comparison: "Vergleich",
    keyPoints: "Kernpunkte",
    checklist: "Checkliste",
    relatedPages: "Zugehörige Seiten",
    faq: "Häufig gestellte Fragen",
  },
  ru: {
    comparison: "Сравнение",
    keyPoints: "Ключевые моменты",
    checklist: "Контрольный список",
    relatedPages: "Связанные страницы",
    faq: "Частые вопросы",
  },
};
const text = labels[locale];
---

{
  placement === "before" && (
    <>
      {callout && (
        <aside class="insight-callout" data-tone={callout.type}>
          {callout.title && <h2>{callout.title}</h2>}
          <p>{callout.text}</p>
        </aside>
      )}

      {insightGrid && (
        <section
          class="insight-feature insight-feature--grid"
          aria-labelledby="insight-grid-title"
        >
          {insightGrid.eyebrow && (
            <p class="insight-feature__eyebrow">{insightGrid.eyebrow}</p>
          )}
          <h2 id="insight-grid-title">{insightGrid.title}</h2>
          {insightGrid.description && <p>{insightGrid.description}</p>}
          <ul>
            {insightGrid.items.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )
}

{
  placement === "after" && (
    <>
      {processFigure && (
        <section
          class="insight-feature insight-feature--process"
          aria-labelledby="insight-process-title"
        >
          {processFigure.eyebrow && (
            <p class="insight-feature__eyebrow">{processFigure.eyebrow}</p>
          )}
          <h2 id="insight-process-title">{processFigure.title}</h2>
          {processFigure.description && <p>{processFigure.description}</p>}
          <ol>
            {processFigure.steps.map((step, index) => (
              <li>
                <span aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      {compareTable && (
        <section
          class="insight-feature insight-feature--compare"
          aria-labelledby="insight-compare-title"
        >
          <h2 id="insight-compare-title">
            {compareTable.title ?? text.comparison}
          </h2>
          <div>
            {[compareTable.before, compareTable.after].map((column) => (
              <section>
                <h3>{column.label}</h3>
                <ul>
                  {column.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>
      )}

      {statBar && (
        <section
          class="insight-feature insight-feature--stats"
          aria-label={text.keyPoints}
        >
          <dl>
            {statBar.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
                {item.description && <p>{item.description}</p>}
              </div>
            ))}
          </dl>
        </section>
      )}

      {checklist && (
        <section
          class="insight-feature insight-feature--checklist"
          aria-labelledby="insight-checklist-title"
        >
          <h2 id="insight-checklist-title">
            {checklist.title ?? text.checklist}
          </h2>
          <ul>
            {checklist.items.map((item) => (
              <li>
                <span aria-hidden="true">{item.checked ? "✓" : "—"}</span>
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {linkCards && (
        <section
          class="insight-feature insight-feature--links"
          aria-labelledby="insight-links-title"
        >
          <h2 id="insight-links-title">{text.relatedPages}</h2>
          <ul>
            {linkCards.map((item) => (
              <li>
                <a href={resolveInsightHref(item.href, locale)}>
                  <strong>{item.title}</strong>
                  {item.description && <span>{item.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {faq && (
        <section
          class="insight-feature insight-feature--faq"
          aria-labelledby="insight-faq-title"
        >
          <h2 id="insight-faq-title">{faq.title ?? text.faq}</h2>
          <div>
            {faq.items.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </>
  )
}
