---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceHandoff from "./ServiceHandoff.astro";
import ServiceVisual from "./ServiceVisual.astro";
import PurposeWork from "./PurposeWork.astro";
import WebsitePricePreview from "./WebsitePricePreview.astro";
import PurposeIcon from "./PurposeIcon.astro";
import site from "../data/site.json";
import development from "../data/service-details/development.json";
import siteFunctions from "../data/service-details/site-functions.json";
import website from "../data/service-details/website.json";
import { getAvailableRouteLocales } from "../lib/insight-links.mjs";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

type ServiceDetail = typeof siteFunctions & {
  handoff?: typeof development.handoff;
  visual?: typeof development.visual;
  sectionVisuals?: typeof development.sectionVisuals;
  heroPrimaryCta?: string;
  heroBenefits?: string[];
  heroSecondaryCta?: string;
  costExample?: typeof website.costExample;
  termsTitle?: string;
  terms?: typeof website.terms;
  faqsTitle?: string;
  faqs?: typeof website.faqs;
};

interface Props {
  data: ServiceDetail;
  canonicalPath: string;
  serviceKey: string;
  consultationServiceKey?:
    "business-system" | "it-advisor" | "website" | "security";
  locale?: Locale;
}

const {
  data,
  canonicalPath: canonicalInput,
  serviceKey,
  consultationServiceKey = serviceKey,
  locale = "ja",
} = Astro.props;
const content = getLocalizedContent(locale);
const { pricing, itAdvisor } = content;
const {
  development: localizedDevelopment,
  siteFunctions: localizedSiteFunctions,
  siteQuality,
  operations,
  security,
} = content.serviceDetails;
const text = getUi(locale);
const canonicalPath = getLocalizedUrl(canonicalInput, locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
const serviceIndex = [
  ...(getAvailableRouteLocales("/services/website/").includes(locale)
    ? [
        {
          href: getLocalizedUrl("/services/website/", locale),
          data: content.serviceDetails.website,
        },
      ]
    : []),
  {
    href: getLocalizedUrl("/services/development/", locale),
    data: localizedDevelopment,
  },
  {
    href: getLocalizedUrl("/services/it-advisor/", locale),
    data: itAdvisor,
  },
  {
    href: getLocalizedUrl("/services/site-functions/", locale),
    data: localizedSiteFunctions,
  },
  {
    href: getLocalizedUrl("/services/site-quality/", locale),
    data: siteQuality,
  },
  {
    href: getLocalizedUrl("/services/operations/", locale),
    data: operations,
  },
  {
    href: getLocalizedUrl("/services/security/", locale),
    data: security,
  },
];
const relatedServices = serviceIndex.filter(
  (service) => service.href !== canonicalPath,
);
const pageUrl = new URL(canonicalPath, site.siteUrl).href;
const serviceEntityId = `${pageUrl}#service`;
const organizationId = `${new URL("/", site.acecoreUrl).href}#organization`;
const pricingByKey = new Map(pricing.items.map((item) => [item.key, item]));
const resolvePricing = (key: string) => {
  const item = pricingByKey.get(key);
  if (!item) {
    throw new Error(`Unknown pricing key: ${key}`);
  }
  return item;
};
const offerings = data.offerings.map((offering) => ({
  ...offering,
  pricing: offering.pricingKeys.map(resolvePricing),
}));
const contactHref = `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams(
  {
    category: "service",
    service: consultationServiceKey,
    from: `systems-${serviceKey}`,
    entry: "service-detail-cta",
  },
).toString()}`;
const jsonLd = [
  ...(data.faqs?.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: data.faqs.map((faq) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: { "@type": "Answer", text: faq.answer },
          })),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": serviceEntityId,
    name: data.title,
    url: pageUrl,
    description: data.description,
    serviceType: data.offerings.map((offering) => offering.title),
    areaServed: "JP",
    provider: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: text.home,
        item: new URL(getLocalizedUrl("/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: text.services,
        item: new URL(getLocalizedUrl("/services/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: data.title,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={serviceEntityId}
  bodyClass={"service-detail-page" +
    (serviceKey === "website" ? " service-detail-page--website" : "")}
  locale={locale}
>
  <section class="page-hero page-hero--detail">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label={text.breadcrumbNavigation}>
        <ol>
          <li><a href={getLocalizedUrl("/", locale)}>{text.home}</a></li>
          <li>
            <a href={getLocalizedUrl("/services/", locale)}>{text.services}</a>
          </li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>
      <div class:list={[serviceKey === "website" && "purpose-split-hero"]}>
        <div class="purpose-hero-copy">
          <p class="page-eyebrow">
            {serviceKey === "website" ? data.title : data.heroEyebrow}
          </p>
          <h1 class="page-title">{data.heroTitle}</h1>
          <p class="page-lead">{data.heroLead}</p>
          {
            Boolean(data.heroBenefits?.length) && (
              <ul class="purpose-hero-benefits">
                {data.heroBenefits.map((benefit) => (
                  <li>
                    <PurposeIcon name="check" />
                    {benefit}
                  </li>
                ))}
              </ul>
            )
          }
          {
            data.heroPrimaryCta && (
              <div class="home-actions">
                <a
                  class="editorial-link editorial-link--primary"
                  href={contactHref}
                >
                  {data.heroPrimaryCta}
                </a>
                <a
                  class="editorial-link"
                  href={
                    serviceKey === "website"
                      ? "#website-pricing-preview"
                      : `#${data.offerings[0].id}`
                  }
                >
                  {data.heroSecondaryCta}
                </a>
              </div>
            )
          }
        </div>
        {
          serviceKey === "website" && (
            <PurposeWork locale={locale} compact hero />
          )
        }
      </div>
    </div>
  </section>

  {
    serviceKey === "website" && (
      <>
        <nav class="purpose-detail-nav" aria-label={text.tableOfContents}>
          <a href="#detail-introduction-title">{text.purposeFeatures}</a>
          <a
            href={getLocalizedUrl("/works/", locale) + "#case-cherry-homepage"}
          >
            {text.works}
          </a>
          <a href="#website-pricing-preview">{text.pricing}</a>
          <a href="#detail-process-title">{text.processTitle}</a>
          <a href="#website-faq-title">{data.faqsTitle}</a>
        </nav>
        <WebsitePricePreview locale={locale} />
      </>
    )
  }

  {
    data.visual && serviceKey !== "website" && (
      <section
        class="service-story-visual-section"
        aria-label={data.visual.alt}
      >
        <div class="container">
          <ServiceVisual {...data.visual} />
        </div>
      </section>
    )
  }

  <section
    class="page-section detail-introduction"
    aria-labelledby="detail-introduction-title"
  >
    <div class="container detail-introduction__layout">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Starting point / 01</p>
        <h2 id="detail-introduction-title">{data.introTitle}</h2>
        <p>{data.introBody}</p>
      </header>
      <div class="detail-challenges" aria-label={text.challengesLabel}>
        {
          data.challenges.map((challenge, index) => (
            <article class="detail-challenge">
              <p class="editorial-index">
                Issue {String(index + 1).padStart(2, "0")}
              </p>
              <h3>{challenge.title}</h3>
              <p>{challenge.body}</p>
            </article>
          ))
        }
      </div>
      <p class="detail-price-note">{pricing.heroLead}</p>
    </div>
  </section>

  {
    data.handoff && (
      <section class="page-section page-section--muted service-handoff-section">
        <div class="container">
          <ServiceHandoff
            {...data.handoff}
            href={localizeHref(data.handoff.href)}
          />
        </div>
      </section>
    )
  }

  <section
    class="page-section page-section--muted"
    aria-labelledby="detail-offerings-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Scope / 02</p>
          <h2 id="detail-offerings-title">{data.offeringsTitle}</h2>
        </div>
        <p>{data.offeringsLead}</p>
      </header>
      {
        data.sectionVisuals?.scope && (
          <ServiceVisual {...data.sectionVisuals.scope} variant="section" />
        )
      }
      <div class="detail-offering-list">
        {
          offerings.map((offering, index) => (
            <article class="detail-offering" id={offering.id}>
              <header class="detail-offering__header">
                <p class="editorial-index">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3>{offering.title}</h3>
              </header>
              <div class="detail-offering__body">
                <p>{offering.body}</p>
                <ul class="service-points">
                  {offering.includes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="detail-offering__price">
                <div class="detail-offering__price-copy">
                  {offering.pricing.map((item) => (
                    <p>
                      {item.label} {item.price}
                    </p>
                  ))}
                  {offering.priceNote && (
                    <p class="detail-offering__price-note">
                      {offering.priceNote}
                    </p>
                  )}
                </div>
                <a href={getLocalizedUrl("/pricing/", locale)}>
                  {text.pricingList}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    data.costExample && (
      <section
        class="page-section website-cost-example"
        aria-labelledby="website-cost-title"
      >
        <div class="container">
          <aside class="editorial-cta">
            <div class="editorial-cta__copy">
              <>
                <p class="editorial-eyebrow">Cost example</p>
                <h2 id="website-cost-title">{data.costExample.title}</h2>
                <p>{data.costExample.body}</p>
              </>
            </div>
            <a
              class="editorial-link editorial-link--primary"
              href={contactHref}
            >
              {data.heroPrimaryCta}
            </a>
          </aside>
        </div>
      </section>
    )
  }

  {
    data.terms?.length && (
      <section
        class="page-section page-section--muted"
        aria-labelledby="website-terms-title"
      >
        <div class="container">
          <header class="editorial-header">
            <>
              <p class="editorial-eyebrow">Scope & handover</p>
              <h2 id="website-terms-title">{data.termsTitle}</h2>
            </>
          </header>
          <div class="website-terms">
            {data.terms.map((term) => (
              <article>
                <h3>{term.title}</h3>
                <p>{term.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="page-section" aria-labelledby="detail-process-title">
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Process / 03</p>
          <h2 id="detail-process-title">{data.processTitle}</h2>
        </div>
        <p>{data.processLead}</p>
      </header>
      {
        data.sectionVisuals?.process && (
          <ServiceVisual {...data.sectionVisuals.process} variant="section" />
        )
      }
      <ol class="service-process">
        {
          data.process.map((step, index) => (
            <li class="service-process__step">
              <p class="editorial-index">
                Step {String(index + 1).padStart(2, "0")}
              </p>
              <div class="service-process__content">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    data.faqs?.length && (
      <section
        class="page-section page-section--muted"
        aria-labelledby="website-faq-title"
      >
        <div class="container">
          <header class="editorial-header">
            <>
              <p class="editorial-eyebrow">FAQ</p>
              <h2 id="website-faq-title">{data.faqsTitle}</h2>
            </>
          </header>
          <div class="website-terms">
            {data.faqs.map((faq) => (
              <article>
                <h3>{faq.question}</h3>
                <p>{faq.answer}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section
    class="page-section page-section--muted"
    aria-labelledby="detail-resources-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Technical notes / 04</p>
          <h2 id="detail-resources-title">{data.resourcesTitle}</h2>
        </div>
        <p>{data.resourcesLead}</p>
      </header>
      <div class="detail-resource-list">
        {
          data.resources.map((resource, index) => (
            <a class="detail-resource" href={localizeHref(resource.href)}>
              <p class="editorial-index">
                Note {String(index + 1).padStart(2, "0")}
              </p>
              <div>
                <h3>{resource.title}</h3>
                <p>{resource.description}</p>
              </div>
              <span>{text.readTechnicalNote}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="page-section detail-related-section"
    aria-labelledby="detail-related-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Related / 05</p>
        <h2 id="detail-related-title">{text.relatedSupport}</h2>
      </header>
      <div
        class:list={[
          "detail-related-list",
          {
            "detail-related-list--three": relatedServices.length === 3,
            "detail-related-list--grid": relatedServices.length >= 4,
          },
        ]}
      >
        {
          relatedServices.map((service) => (
            <a class="detail-related" href={service.href}>
              <p class="editorial-eyebrow">{service.data.heroEyebrow}</p>
              <h3>{service.data.title}</h3>
              <p>{service.data.indexSummary}</p>
              <span>{text.viewSupport}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside
        class="editorial-cta service-cta"
        aria-labelledby="detail-cta-title"
      >
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Consultation</p>
          <h2 id="detail-cta-title">{data.ctaTitle}</h2>
          <p>{data.ctaBody}</p>
        </div>
        <a class="editorial-link editorial-link--primary" href={contactHref}>
          {text.discussThis}
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @layer theme, base, components, utilities;
  @layer components {
    .website-terms {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--line-strong);
    }
    .website-terms article {
      display: grid;
      grid-template-columns: minmax(180px, 0.65fr) minmax(0, 1.35fr);
      gap: 20px 48px;
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
    }
    .website-terms h3 {
      font-size: 1rem;
      line-height: 1.8;
    }
    .website-terms p {
      color: var(--ink-soft);
      line-height: 1.9;
    }
    @media (max-width: 680px) {
      .website-terms article {
        grid-template-columns: 1fr;
        gap: 10px;
      }
    }
    .detail-related-list--grid .detail-related {
      border-bottom: 1px solid var(--line);
    }

    .detail-related-list--grid .detail-related:nth-child(even) {
      border-right: 0;
    }

    .detail-related-list--grid .detail-related:last-child,
    .detail-related-list--grid
      .detail-related:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }

    @media (max-width: 860px) {
      .detail-related-list--grid .detail-related:nth-last-child(-n + 2) {
        border-bottom: 1px solid var(--line);
      }

      .detail-related-list--grid .detail-related:last-child {
        border-bottom: 0;
      }
    }
  }
</style>
