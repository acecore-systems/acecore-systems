---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceHandoff from "./ServiceHandoff.astro";
import PurposeWork from "./PurposeWork.astro";
import PurposeCaseCards from "./PurposeCaseCards.astro";
import PurposeIcon from "./PurposeIcon.astro";
import site from "../data/site.json";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import { getServiceCatalog } from "../lib/service-catalog";
import {
  presentService,
  relatedServiceIds,
  type ServiceContent,
} from "../lib/service-presentation";

interface Props {
  data: ServiceContent;
  canonicalPath: string;
  serviceKey: string;
  consultationServiceKey?: string;
  locale?: Locale;
}
const {
  data: source,
  canonicalPath: canonicalInput,
  serviceKey,
  consultationServiceKey = serviceKey,
  locale = "ja",
} = Astro.props;
const data = presentService(source, serviceKey);
const content = getLocalizedContent(locale);
const text = getUi(locale);
const canonicalPath = getLocalizedUrl(canonicalInput, locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
const pricingByKey = new Map(
  content.pricing.items.map((item) => [item.key, item]),
);
const resolvePricing = (key: string) => {
  const item = pricingByKey.get(key);
  if (!item) throw new Error(`Unknown pricing key: ${key}`);
  return item;
};
const offerings = data.offerings.map((offering) => ({
  ...offering,
  pricing: offering.pricingKeys.map(resolvePricing),
}));
const relatedIds = relatedServiceIds[data.routeId] ?? [];
const relatedServices = getServiceCatalog(content, locale)
  .flatMap((group) => group.items)
  .filter((service) => relatedIds.includes(service.id));
const contactHref = `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams({ category: "service", service: consultationServiceKey, from: `systems-${serviceKey}`, entry: "service-detail-cta" }).toString()}`;
const faqs = data.faqs.length
  ? data.faqs
  : [
      { question: text.serviceFaqPricing, answer: content.pricing.heroLead },
      { question: text.serviceFaqScope, answer: data.offeringsLead },
      { question: text.serviceFaqProcess, answer: data.processLead },
    ];
const pageUrl = new URL(canonicalPath, site.siteUrl).href;
const serviceEntityId = `${pageUrl}#service`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": serviceEntityId,
    name: data.title,
    url: pageUrl,
    description: data.description,
    serviceType: data.advisor
      ? data.indexTopics
      : data.offerings.map((offering) => offering.title),
    areaServed: "JP",
    ...(data.advisor
      ? {
          audience: {
            "@type": "Audience",
            audienceType: data.advisor.audienceValue,
          },
        }
      : {}),
    provider: { "@id": `${new URL("/", site.acecoreUrl).href}#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: text.home,
        item: new URL(getLocalizedUrl("/", locale), site.siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: text.services,
        item: new URL(getLocalizedUrl("/services/", locale), site.siteUrl).href,
      },
      { "@type": "ListItem", position: 3, name: data.title, item: pageUrl },
    ],
  },
];
const legacyScope = content.services.services.filter(
  (service) =>
    data.routeId === "development" &&
    ["integration", "modernization"].includes(service.id),
);
const pricingAnchor =
  serviceKey === "website"
    ? "website-pricing-preview"
    : serviceKey === "it-advisor"
      ? "plans"
      : "detail-offerings";
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={serviceEntityId}
  bodyClass={"service-detail-page selection-detail" +
    (serviceKey === "website" ? " service-detail-page--website" : "") +
    (data.advisor ? " it-advisor-page" : "")}
  locale={locale}
>
  <section class="page-hero page-hero--detail selection-hero">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label={text.breadcrumbNavigation}>
        <ol>
          <li><a href={getLocalizedUrl("/", locale)}>{text.home}</a></li>
          <li>
            <a href={getLocalizedUrl("/services/", locale)}>{text.services}</a>
          </li>
          <li aria-current="page">{data.title}</li>
        </ol>
      </nav>
      <div class="purpose-split-hero">
        <div class="purpose-hero-copy">
          <p class="page-eyebrow">{data.title}</p>
          <h1 class="page-title">{data.heroTitle}</h1>
          <p class="page-lead">{data.heroLead}</p>
          {
            data.heroBenefits.length > 0 && (
              <ul class="purpose-hero-benefits">
                {data.heroBenefits.map((benefit) => (
                  <li>
                    <PurposeIcon name="check" />
                    {benefit}
                  </li>
                ))}
              </ul>
            )
          }
          <div class="home-actions">
            <a class="editorial-link editorial-link--primary" href={contactHref}
              >{data.heroPrimaryCta ?? text.discussThis}</a
            >
            <a class="editorial-link" href={"#" + pricingAnchor}
              >{data.heroSecondaryCta ?? text.pricingGuideTitle}</a
            >
          </div>
          {
            data.advisor && (
              <dl class="selection-audience">
                <>
                  <div>
                    <>
                      <dt>{data.advisor.audienceLabel}</dt>
                      <dd>{data.advisor.audienceValue}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>{data.advisor.engagementLabel}</dt>
                      <dd>{data.advisor.engagementValue}</dd>
                    </>
                  </div>
                </>
              </dl>
            )
          }
        </div>
        {
          serviceKey === "website" ? (
            <PurposeWork locale={locale} compact hero />
          ) : (
            <aside class="selection-hero-summary">
              <>
                <p class="purpose-eyebrow">{text.serviceDeliverables}</p>
                <ul>
                  {data.indexTopics.map((topic) => (
                    <li>
                      <PurposeIcon name="check" />
                      {topic}
                    </li>
                  ))}
                </ul>
                <p>{data.indexSummary}</p>
                <a class="purpose-text-link" href={"#" + pricingAnchor}>
                  {text.scopeLabel} / {text.pricing}
                  <PurposeIcon name="arrow" />
                </a>
              </>
            </aside>
          )
        }
      </div>
    </div>
  </section>
  <nav class="purpose-detail-nav" aria-label={text.services}>
    <a href="#detail-introduction-title">{text.serviceFor}</a><a
      href={"#" + pricingAnchor}>{text.scopeLabel} / {text.pricing}</a
    ><a href="#detail-process-title">{text.processTitle}</a><a
      href="#detail-faq-title">{data.faqsTitle ?? text.serviceFaqTitle}</a
    >
  </nav>
  <section
    class="page-section selection-introduction"
    aria-labelledby="detail-introduction-title"
  >
    <div class="container">
      <header class="purpose-section-heading">
        <div>
          <p class="purpose-eyebrow">{text.serviceFor}</p><h2
            id="detail-introduction-title"
          >
            {data.introTitle}
          </h2><p>{data.introBody}</p>
        </div>
      </header>
      <div class="selection-challenges">
        {
          data.challenges.map((challenge) => (
            <article>
              <>
                <h3>{challenge.title}</h3>
                <p>{challenge.body}</p>
              </>
            </article>
          ))
        }
      </div>
      {
        data.handoff && (
          <ServiceHandoff
            {...data.handoff}
            href={localizeHref(data.handoff.href)}
          />
        )
      }
    </div>
  </section>
  {
    serviceKey === "website" && (
      <section
        class="page-section selection-evidence"
        aria-labelledby="detail-evidence-title"
      >
        <div class="container">
          <>
            <header class="purpose-section-heading">
              <>
                <div>
                  <>
                    <p class="purpose-eyebrow">{text.works}</p>
                    <h2 id="detail-evidence-title">{text.selectedWorkTitle}</h2>
                    <p>{text.selectedWorkLead}</p>
                  </>
                </div>
                <a
                  class="purpose-text-link"
                  href={getLocalizedUrl("/works/", locale)}
                >
                  {text.viewWorks}
                  <PurposeIcon name="arrow" />
                </a>
              </>
            </header>
            <PurposeCaseCards
              locale={locale}
              ids={["case-hatt-homepage", "case-acecore-site-platform"]}
            />
          </>
        </div>
      </section>
    )
  }
  <section
    class="page-section selection-offerings"
    id={pricingAnchor}
    aria-labelledby="detail-offerings-title"
  >
    <div class="container">
      <header class="purpose-section-heading">
        <div>
          <p class="purpose-eyebrow">{text.scopeLabel} / {text.pricing}</p><h2
            id="detail-offerings-title"
          >
            {data.offeringsTitle}
          </h2>{serviceKey !== "website" && <p>{data.offeringsLead}</p>}<p
            class="selection-tax-note"
          >
            {content.pricing.heroLead}
          </p>
        </div>
      </header>
      <div class="selection-offering-list">
        {
          offerings.map((offering, index) => (
            <article class="selection-offering" id={offering.id}>
              <details open={index === 0}>
                <summary>
                  <>
                    <span class="selection-offering__number">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="selection-offering__copy">
                      <span class="selection-offering__title">
                        {offering.title}
                      </span>
                      <span class="selection-offering__scope">
                        {offering.pricing
                          .map((item) =>
                            serviceKey === "website"
                              ? item.note.split(" 税込の目安。")[0]
                              : item.note,
                          )
                          .join(" / ")}
                      </span>
                    </span>
                    <span class="selection-offering__prices">
                      {offering.pricing.map((item) => (
                        <span>
                          <span>{item.label}</span>
                          <strong>{item.price}</strong>
                        </span>
                      ))}
                    </span>
                    <PurposeIcon name="chevron" />
                  </>
                </summary>
                <div class="selection-offering__body">
                  <>
                    <div>
                      <>
                        <p>{offering.body}</p>
                        <ul class="service-points">
                          {offering.includes.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </>
                    </div>
                    <aside>
                      <h4>{text.serviceTerms}</h4>
                      {offering.pricing.map((item) => (
                        <p>{item.note}</p>
                      ))}
                      {offering.priceNote && <p>{offering.priceNote}</p>}
                      <a
                        class="purpose-text-link"
                        href={
                          getLocalizedUrl("/pricing/", locale) +
                          "#" +
                          offering.pricing[0].key
                        }
                      >
                        {text.pricingCheck}
                        <PurposeIcon name="arrow" />
                      </a>
                    </aside>
                  </>
                </div>
              </details>
            </article>
          ))
        }
      </div>
      {
        data.advisor && (
          <p class="selection-contract-note">{data.advisor.priceNote}</p>
        )
      }
      {
        legacyScope.length > 0 && (
          <details class="purpose-disclosure">
            <>
              <summary>
                <>
                  <h3>{text.scopeLabel}</h3>
                  <PurposeIcon name="chevron" />
                </>
              </summary>
              <div class="purpose-disclosure__body selection-supplement-grid">
                {legacyScope.map((service) => (
                  <article>
                    <h4>{service.title}</h4>
                    <p>{service.body}</p>
                    <ul class="service-points">
                      {service.examples.map((example) => (
                        <li>{example}</li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </>
          </details>
        )
      }
      {
        data.costExample && (
          <aside class="selection-cost-example">
            <>
              <h3>{data.costExample.title}</h3>
              <p>{data.costExample.body}</p>
            </>
          </aside>
        )
      }
      {
        data.terms.length > 0 && (
          <details class="purpose-disclosure selection-terms">
            <>
              <summary>
                <>
                  <h3>{data.termsTitle}</h3>
                  <PurposeIcon name="chevron" />
                </>
              </summary>
              <div class="purpose-disclosure__body">
                {data.terms.map((term) => (
                  <article>
                    <h4>{term.title}</h4>
                    <p>{term.body}</p>
                  </article>
                ))}
              </div>
            </>
          </details>
        )
      }
    </div>
  </section>
  {
    data.advisor && (
      <section
        class="page-section selection-advisor-scope"
        aria-labelledby="advisor-support-title"
      >
        <div class="container">
          <>
            <header class="purpose-section-heading">
              <div>
                <>
                  <h2 id="advisor-support-title">
                    {data.advisor.supportTitle}
                  </h2>
                  <p>{data.advisor.supportLead}</p>
                </>
              </div>
            </header>
            <div class="selection-support-grid">
              {data.advisor.supportAreas.map((area) => (
                <article id={area.id}>
                  <h3>{area.title}</h3>
                  <p>{area.body}</p>
                  <ul class="service-points">
                    {area.includes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
            <details class="purpose-disclosure">
              <>
                <summary>
                  <>
                    <h3>{data.advisor.useCasesTitle}</h3>
                    <PurposeIcon name="chevron" />
                  </>
                </summary>
                <div class="purpose-disclosure__body">
                  <>
                    <p>{data.advisor.useCasesLead}</p>
                    <div class="selection-supplement-grid">
                      {data.advisor.useCases.map((item) => (
                        <article>
                          <h4>{item.title}</h4>
                          <p>{item.body}</p>
                        </article>
                      ))}
                    </div>
                  </>
                </div>
              </>
            </details>
            <details class="purpose-disclosure">
              <>
                <summary>
                  <>
                    <h3>{data.advisor.governanceTitle}</h3>
                    <PurposeIcon name="chevron" />
                  </>
                </summary>
                <div class="purpose-disclosure__body">
                  <>
                    <p>{data.advisor.governanceLead}</p>
                    <h4>{text.securityResponsibility}</h4>
                    <ul class="service-points">
                      {data.advisor.governance.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                    <h4>{data.advisor.excludedTitle}</h4>
                    <p>{data.advisor.excludedLead}</p>
                    <ul class="service-points">
                      {data.advisor.excluded.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </div>
              </>
            </details>
          </>
        </div>
      </section>
    )
  }
  <section
    class="page-section selection-process-section"
    aria-labelledby="detail-process-title"
  >
    <div class="container">
      <header class="purpose-section-heading">
        <div>
          <p class="purpose-eyebrow">{text.processTitle}</p><h2
            id="detail-process-title"
          >
            {data.processTitle}
          </h2><p>{data.processLead}</p>
        </div>
      </header><ol class="selection-process">
        {
          data.process.map((step, index) => (
            <li>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section
    class="page-section selection-faq-section"
    aria-labelledby="detail-faq-title"
  >
    <div class="container selection-reading-width">
      <header class="purpose-section-heading">
        <div>
          <p class="purpose-eyebrow">FAQ</p><h2 id="detail-faq-title">
            {data.faqsTitle ?? text.serviceFaqTitle}
          </h2>{data.faqLead && <p>{data.faqLead}</p>}
        </div>
      </header><div class="selection-faq">
        {
          faqs.map((faq) => (
            <details>
              <>
                <summary>
                  <>
                    <span>{faq.question}</span>
                    <PurposeIcon name="chevron" />
                  </>
                </summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  {
    data.resources.length > 0 && (
      <section
        class="page-section selection-resources"
        aria-labelledby="detail-resources-title"
      >
        <div class="container">
          <details class="purpose-disclosure">
            <>
              <summary>
                <>
                  <h2 id="detail-resources-title">{data.resourcesTitle}</h2>
                  <PurposeIcon name="chevron" />
                </>
              </summary>
              <div class="purpose-disclosure__body">
                <>
                  <p>{data.resourcesLead}</p>
                  <div class="selection-resource-grid">
                    {data.resources.map((resource) => (
                      <a href={localizeHref(resource.href)}>
                        <h3>{resource.title}</h3>
                        <p>{resource.description}</p>
                        <span>{text.readTechnicalNote}</span>
                      </a>
                    ))}
                  </div>
                </>
              </div>
            </>
          </details>
        </div>
      </section>
    )
  }
  <section
    class="page-section selection-related"
    aria-labelledby="detail-related-title"
  >
    <div class="container">
      <header class="purpose-section-heading">
        <h2 id="detail-related-title">{text.relatedSupport}</h2><a
          class="purpose-text-link"
          href={getLocalizedUrl("/services/", locale)}
          >{text.purposeViewServices}<PurposeIcon name="arrow" /></a
        >
      </header><div class="selection-related-grid">
        {
          relatedServices.map((service) => (
            <a href={getLocalizedUrl(service.href, locale)}>
              <>
                <PurposeIcon name={service.icon} />
                <div>
                  <>
                    <h3>{service.data.title}</h3>
                    <p>{service.data.indexSummary}</p>
                  </>
                </div>
                <PurposeIcon name="chevron" />
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="page-section page-section--cta">
    <div class="container">
      <aside
        class="editorial-cta service-cta"
        aria-labelledby="detail-cta-title"
      >
        <div class="editorial-cta__copy">
          <h2 id="detail-cta-title">{data.ctaTitle}</h2><p>{data.ctaBody}</p>
        </div><a
          class="editorial-link editorial-link--primary"
          href={contactHref}>{text.discussThis}</a
        >
      </aside>
    </div>
  </section>
</BaseLayout>
<script>
  const revealLinkedDetails = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const details =
      target instanceof HTMLDetailsElement
        ? target
        : target?.querySelector("details");
    if (details instanceof HTMLDetailsElement) details.open = true;
  };
  revealLinkedDetails();
  window.addEventListener("hashchange", revealLinkedDetails);
</script>
