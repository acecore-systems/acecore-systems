---
import BrandName from "./BrandName.astro";
import site from "../data/site.json";
import { ACECORE_ORGANIZATION } from "../data/organization.ts";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import { getLocalizedContent } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = getUi(locale);
const content = getLocalizedContent(locale);
const footerLinks = content.site.footerLinks.map((item) => ({
  ...item,
  href: getLocalizedUrl(item.href, locale),
}));
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a
        class="footer-brand__identity"
        href={getLocalizedUrl("/", locale)}
        aria-label="Acecore Systems"
      >
        <img
          class="footer-brand__logo"
          src="/logo.svg"
          alt={`${site.name} ロゴ`}
          width="38"
          height="38"
        />
        <strong>
          <BrandName name={site.name} />
        </strong>
      </a>
      <span>Systems for Operations</span>
      <p>{content.site.description}</p>
      <p class="footer-image-credit" data-cast-scene-credit>
        {content.site.footerImageDisclosure}{" "}
        <a href="https://cast.acecore.net/">
          {content.site.footerImageCreditLabel}
        </a>
      </p>
    </div>
    <nav class="footer-links" aria-label={text.footerNavigation}>
      {footerLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="footer-meta">
      <a href={new URL(getLocalizedUrl("/", locale), site.acecoreUrl).href}>
        {text.operatedBy}
      </a>
      <a
        href={new URL(getLocalizedUrl("/about/", locale), site.acecoreUrl).href}
      >
        {text.companyInfoLabel}
      </a>
      <span>
        © {new Date().getFullYear()} {ACECORE_ORGANIZATION.legalName}
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-brand .footer-image-credit {
    margin-top: 16px;
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .footer-image-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
