---
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import PurposeIcon from "./PurposeIcon.astro";
interface Props {
  locale: Locale;
  compact?: boolean;
  hero?: boolean;
}
const { locale, compact = false, hero = false } = Astro.props;
const { works } = getLocalizedContent(locale);
const text = getUi(locale);
const work = works.cases.find((item) => item.id === "case-cherry-homepage");
const href = `${getLocalizedUrl("/works/", locale)}#case-cherry-homepage`;
---

{
  work && (
    <figure
      class:list={[
        "purpose-work",
        compact && "purpose-work--compact",
        hero && "purpose-work--hero",
      ]}
    >
      <a
        class:list={["purpose-work__image", hero && "purpose-device-stage"]}
        href={href}
      >
        {hero ? (
          <>
            <img
              class="purpose-device-frame"
              src="/images/works/cherry-device-frame.webp"
              alt=""
              aria-hidden="true"
              width="1536"
              height="1024"
              decoding="async"
            />
            <img
              class="purpose-device-screen"
              src={work.image}
              alt={work.imageAlt}
              width="1585"
              height="892"
              decoding="async"
            />
            <img
              class="purpose-device-phone-frame"
              src="/images/works/cherry-device-frame.webp"
              alt=""
              aria-hidden="true"
              width="1536"
              height="1024"
              decoding="async"
            />
            <img
              class="purpose-device-phone-screen"
              src="/images/works/cherry-mobile.jpg"
              alt=""
              aria-hidden="true"
              width="375"
              height="811"
              decoding="async"
            />
          </>
        ) : (
          <img
            src={work.image}
            alt={work.imageAlt}
            width="1585"
            height="892"
            loading={compact ? "eager" : "lazy"}
            decoding="async"
          />
        )}
      </a>
      <figcaption>
        <span>
          {work.title}
          <span class="purpose-work__category">{work.category}</span>
        </span>
        <a href={href}>
          {text.viewWorks}
          <PurposeIcon name="arrow" />
        </a>
      </figcaption>
    </figure>
  )
}
