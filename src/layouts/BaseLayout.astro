---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import { serializeJsonForHtmlScript } from "../lib/safe-json.ts";
import {
  getAlternateUrls,
  getLocaleFromUrl,
  getLocalizedUrl,
  htmlLangMap,
  locales,
  ogLocaleMap,
  type Locale,
} from "../i18n";
import { getUi } from "../i18n/ui";
import { getLocalizedContent } from "../i18n/content";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  robots?: string;
  canonical?: string | null;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  mainEntityId?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  locale?: Locale;
}

const {
  title,
  description = site.description,
  image,
  robots = "index, follow",
  canonical: canonicalInput = Astro.url.pathname,
  bodyClass,
  jsonLd: pageJsonLd,
  mainEntityId,
  ogType = "website",
  publishedTime,
  modifiedTime,
  locale: localeInput,
} = Astro.props;
const locale = localeInput ?? getLocaleFromUrl(Astro.url);
const text = getUi(locale);
const content = getLocalizedContent(locale);
const localizedDescription =
  description === site.description && locale !== "ja"
    ? content.site.description
    : description;
const canonicalPath =
  canonicalInput === null
    ? null
    : getLocalizedUrl(new URL(canonicalInput, site.siteUrl).pathname, locale);
const canonical =
  canonicalPath === null ? null : new URL(canonicalPath, site.siteUrl);
const pageUrl = canonical ?? new URL(Astro.url.pathname, site.siteUrl);
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const ogImage = new URL(
  image || "/images/acecore-systems-og.webp",
  site.siteUrl,
).href;
const homeUrl = new URL(getLocalizedUrl("/", locale), site.siteUrl).href;
const acecoreHomeUrl = new URL("/", site.acecoreUrl).href;
const organizationId = `${acecoreHomeUrl}#organization`;
const serviceId = `${homeUrl}#service`;
const serviceUrl = new URL(getLocalizedUrl("/services/", locale), site.siteUrl)
  .href;
const websiteId = `${homeUrl}#website`;
const webPageId = `${pageUrl.href}#webpage`;
const alternateUrls = canonical
  ? getAlternateUrls(canonical.pathname, site.siteUrl)
  : [];
const baseJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    name: "Acecore",
    url: acecoreHomeUrl,
    logo: new URL("/favicon.svg", site.acecoreUrl).href,
    email: site.email,
    telephone: site.phone,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": serviceId,
    name: site.name,
    url: serviceUrl,
    description: localizedDescription,
    serviceType: content.services.services.map((service) => service.title),
    inLanguage: htmlLangMap[locale],
    provider: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    name: site.name,
    url: homeUrl,
    description: localizedDescription,
    inLanguage: htmlLangMap[locale],
    publisher: { "@id": organizationId },
    about: { "@id": serviceId },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": webPageId,
    url: pageUrl.href,
    name: pageTitle,
    description: localizedDescription,
    inLanguage: htmlLangMap[locale],
    isPartOf: { "@id": websiteId },
    about: { "@id": serviceId },
    ...(mainEntityId ? { mainEntity: { "@id": mainEntityId } } : {}),
    publisher: { "@id": organizationId },
  },
];
const jsonLd = pageJsonLd
  ? [...baseJsonLd, ...(Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd])]
  : baseJsonLd;
const serializedJsonLd = serializeJsonForHtmlScript(jsonLd);
---

<!doctype html>
<html lang={htmlLangMap[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="B670753BF4A50FA5437E5694CB04BAFD" />
    <title>{pageTitle}</title>
    <meta name="description" content={localizedDescription} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternateUrls.map((alternate) => (
        <link
          rel="alternate"
          hreflang={htmlLangMap[alternate.locale]}
          href={alternate.url}
        />
      ))
    }
    {
      canonical && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            alternateUrls.find((alternate) => alternate.locale === "ja")?.url
          }
        />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — ${text.insights}`}
      href={getLocalizedUrl("/rss.xml", locale)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={localizedDescription} />
    <meta property="og:type" content={ogType} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {
      locales
        .filter((targetLocale) => targetLocale !== locale)
        .map((targetLocale) => (
          <meta
            property="og:locale:alternate"
            content={ogLocaleMap[targetLocale]}
          />
        ))
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={localizedDescription} />
    <meta name="twitter:image" content={ogImage} />
    {
      bodyClass === "home-page" && (
        <>
          <link
            rel="preload"
            as="image"
            href="/images/quiet-home-surface-v3-exact.webp"
            media="(min-width: 1041px)"
            fetchpriority="high"
          />
          <link
            rel="preload"
            as="image"
            href="/images/quiet-home-hero-v2-exact.webp"
            media="(max-width: 1040px)"
            fetchpriority="high"
          />
        </>
      )
    }
    <meta name="theme-color" content="#f2f0ea" />
    <script type="application/ld+json" set:html={serializedJsonLd} />
    {
      site.ga4Id && (
        <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
          {`
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function () {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            window.gtag("config", ga4Id);

            let gaLoaded = false;
            const loadGoogleAnalytics = () => {
              if (
                gaLoaded ||
                document.querySelector('script[src*="googletagmanager.com/gtag/js"]')
              ) {
                return;
              }

              gaLoaded = true;
              const script = document.createElement("script");
              script.async = true;
              script.src =
                "https://www.googletagmanager.com/gtag/js?id=" +
                encodeURIComponent(ga4Id);
              document.head.appendChild(script);
            };

            if ("requestIdleCallback" in window) {
              window.requestIdleCallback(loadGoogleAnalytics, { timeout: 4000 });
            } else {
              window.setTimeout(loadGoogleAnalytics, 2000);
            }

            ["pointerdown", "keydown", "scroll"].forEach((eventName) => {
              window.addEventListener(eventName, loadGoogleAnalytics, {
                once: true,
                passive: true,
              });
            });
          `}
        </script>
      )
    }
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{text.skipToContent}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
