---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).works;
const text = getUi(locale);
const localeAwareOrigins = new Set([
  site.acecoreUrl,
  "https://asv.acecore.net",
]);
const localizeHref = (href: string) => {
  if (href.startsWith("/")) return getLocalizedUrl(href, locale);
  const url = new URL(href);
  if (!localeAwareOrigins.has(url.origin)) return href;
  return new URL(
    getLocalizedUrl(`${url.pathname}${url.search}${url.hash}`, locale),
    url.origin,
  ).href;
};
const contactHref = (work: (typeof data.cases)[number]) => {
  const service =
    work.consultationTrack === "it-advisor" ? "it-advisor" : "business-system";
  return `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams({
    category: "service",
    service,
    from: `systems-work-${work.id}`,
    entry: "work-cta",
  }).toString()}`;
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  bodyClass="works-page"
  locale={locale}
>
  <section class="page-hero page-hero--works">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">{text.worksEyebrow}</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section
    class="page-section page-section--works"
    aria-labelledby="work-list-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Cases / 01</p>
        <h2 id="work-list-title">{text.casesTitle}</h2>
      </header>
      <div class="work-list">
        {
          data.cases.map((work, index) => (
            <article
              class:list={[
                "work-case",
                !work.image && "work-case--without-media",
              ]}
              id={work.id}
              aria-labelledby={`${work.id}-title`}
            >
              <header class="work-case__header">
                <p class="editorial-index">
                  Case {String(index + 1).padStart(2, "0")}
                </p>
                <p class="work-case__category">{work.category}</p>
                <h3 id={`${work.id}-title`}>{work.title}</h3>
                <p class="work-case__summary">{work.summary}</p>
              </header>
              {work.image && (
                <figure class="work-case__media">
                  <img
                    src={work.image}
                    alt={work.imageAlt || work.title}
                    width="1536"
                    height="1024"
                    loading="lazy"
                  />
                </figure>
              )}
              <div class="work-case__body">
                <dl class="work-details">
                  <div class="work-details__row">
                    <dt>{text.challenge}</dt>
                    <dd>{work.challenge}</dd>
                  </div>
                  <div class="work-details__row">
                    <dt>{text.proposal}</dt>
                    <dd>{work.proposal}</dd>
                  </div>
                  <div class="work-details__row">
                    <dt>{text.result}</dt>
                    <dd>{work.result}</dd>
                  </div>
                </dl>
                <div class="work-case__links">
                  <a
                    class="editorial-link editorial-link--primary"
                    href={contactHref(work)}
                    aria-label={`${work.title}: ${text.discussThis}`}
                  >
                    {text.discussThis}
                  </a>
                  {work.detailUrl && (
                    <a
                      class="editorial-link"
                      href={localizeHref(work.detailUrl)}
                      aria-label={`${work.title}: ${text.caseDetails}`}
                    >
                      {text.caseDetails}
                    </a>
                  )}
                  {work.externalUrl && (
                    <a
                      class="editorial-link"
                      href={localizeHref(work.externalUrl)}
                    >
                      {work.externalLabel}
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
