---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/works.json";
---

<BaseLayout
  title={data.title}
  description={data.description}
  bodyClass="works-page"
>
  <section class="page-hero page-hero--works">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">Selected work / 取り組み</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section
    class="page-section page-section--works"
    aria-labelledby="work-list-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Cases / 01</p>
        <h2 id="work-list-title">事例</h2>
      </header>
      <div class="work-list">
        {
          data.cases.map((work, index) => (
            <article
              class:list={[
                "work-case",
                !work.image && "work-case--without-media",
              ]}
              id={work.id}
              aria-labelledby={`${work.id}-title`}
            >
              <header class="work-case__header">
                <p class="editorial-index">
                  Case {String(index + 1).padStart(2, "0")}
                </p>
                <p class="work-case__category">{work.category}</p>
                <h3 id={`${work.id}-title`}>{work.title}</h3>
                <p class="work-case__summary">{work.summary}</p>
              </header>
              {work.image && (
                <figure class="work-case__media">
                  <img
                    src={work.image}
                    alt={work.imageAlt || work.title}
                    width="1000"
                    height="680"
                    loading="lazy"
                  />
                </figure>
              )}
              <div class="work-case__body">
                <dl class="work-details">
                  <div class="work-details__row">
                    <dt>課題</dt>
                    <dd>{work.challenge}</dd>
                  </div>
                  <div class="work-details__row">
                    <dt>提案</dt>
                    <dd>{work.proposal}</dd>
                  </div>
                  <div class="work-details__row">
                    <dt>成果</dt>
                    <dd>{work.result}</dd>
                  </div>
                </dl>
                <div class="work-case__links">
                  {work.detailUrl && (
                    <a
                      class="editorial-link editorial-link--primary"
                      href={work.detailUrl}
                      aria-label={`${work.title}の事例詳細を見る`}
                    >
                      事例の詳細を見る
                    </a>
                  )}
                  {work.externalUrl && (
                    <a
                      class="editorial-link"
                      href={work.externalUrl}
                    >
                      {work.externalLabel}
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
