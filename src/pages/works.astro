---
import PurposeIcon from "../components/PurposeIcon.astro";
import PurposeCallout from "../components/PurposeCallout.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import { getContactFormText } from "../i18n/contact-form";
import { getServiceDetails } from "../lib/service-catalog";
import { workServiceContexts } from "../lib/work-services";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const content = getLocalizedContent(locale);
const data = content.works;
const text = getUi(locale);
const serviceLinks = new Map(
  getServiceDetails(content, locale).map(
    (service) =>
      [
        service.id,
        {
          title: service.data.title,
          href: getLocalizedUrl(service.href, locale),
        },
      ] as const,
  ),
);
// A pending website translation must link to an available localized entry.
if (!serviceLinks.has("website"))
  serviceLinks.set("website", {
    title: getContactFormText(locale).categories.website,
    href: getLocalizedUrl("/services/#web", locale),
  });
const relatedServices = (id: string) =>
  (workServiceContexts[id]?.relatedServices ?? []).flatMap((serviceId) => {
    const service = serviceLinks.get(serviceId);
    return service ? [service] : [];
  });
const localeAwareOrigins = new Set([
  site.acecoreUrl,
  "https://asv.acecore.net",
]);
const localizeHref = (href: string) => {
  if (href.startsWith("/")) return getLocalizedUrl(href, locale);
  const url = new URL(href);
  if (!localeAwareOrigins.has(url.origin)) return href;
  return new URL(
    getLocalizedUrl(`${url.pathname}${url.search}${url.hash}`, locale),
    url.origin,
  ).href;
};
const contactHref = (work: (typeof data.cases)[number]) => {
  const service =
    workServiceContexts[work.id]?.consultationService ??
    (work.consultationTrack === "it-advisor"
      ? "it-advisor"
      : "business-system");
  return `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams({
    category: "service",
    service,
    from: `systems-work-${work.id}`,
    entry: "work-cta",
  }).toString()}`;
};

const purposes = [
  { id: "all", label: text.purposeAll },
  { id: "web", label: text.purposeWeb },
  { id: "work", label: text.purposeWork },
  { id: "operate", label: text.purposeOperate },
];
const imageDimensions: Record<string, [number, number]> = {
  "case-acecore-store": [1536, 864],
  "case-cherry-homepage": [1585, 892],
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  bodyClass="works-page purpose-works"
  locale={locale}
>
  <section class="page-hero page-hero--works">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">{text.worksEyebrow}</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>
  <section
    class="page-section page-section--works"
    aria-labelledby="work-list-title"
  >
    <div class="container">
      <header class="purpose-section-heading">
        <h2 id="work-list-title">{text.casesTitle}</h2>
        <a
          class="purpose-text-link"
          href={getLocalizedUrl("/services/", locale)}
        >
          {text.purposeViewServices}
          <PurposeIcon name="arrow" />
        </a>
      </header>
      <nav class="experience-filters" aria-label={text.works}>
        {purposes.map((purpose) => (
          <a
            href={
              getLocalizedUrl("/works/", locale) +
              "?purpose=" +
              purpose.id +
              "#work-list-title"
            }
            data-work-filter={purpose.id}
            aria-current={purpose.id === "all" ? "true" : undefined}
          >
            {purpose.label}
          </a>
        ))}
      </nav>
      <div class="experience-case-grid">
        {data.cases.map((work, index) => (
          <article
            class="experience-case"
            id={work.id}
            data-case-purpose={workServiceContexts[work.id]?.purposes.join(" ")}
            aria-labelledby={`${work.id}-title`}
          >
            {work.image && (
              <figure class="experience-case__media">
                <img
                  src={work.image}
                  alt={work.imageAlt || work.title}
                  width={imageDimensions[work.id]?.[0] ?? 1536}
                  height={imageDimensions[work.id]?.[1] ?? 1024}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
            <div class="experience-case__content">
              <header>
                <p class="experience-case__category">
                  <span>Case {String(index + 1).padStart(2, "0")}</span>
                  {work.category}
                </p>
                <h3 id={`${work.id}-title`}>{work.title}</h3>
                <p class="experience-case__summary">{work.summary}</p>
              </header>
              <div class="experience-case__result">
                <>
                  <h4>{text.result}</h4>
                  <p>{work.result}</p>
                </>
              </div>
              <details class="experience-case__details">
                <summary>
                  <>
                    <span>
                      {text.challenge} / {text.proposal}
                    </span>
                    <PurposeIcon name="chevron" />
                  </>
                </summary>
                <dl>
                  <>
                    <div>
                      <>
                        <dt>{text.challenge}</dt>
                        <dd>{work.challenge}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>{text.proposal}</dt>
                        <dd>{work.proposal}</dd>
                      </>
                    </div>
                  </>
                </dl>
              </details>
              <div class="experience-case__services">
                <h4>{text.workRelatedServices}</h4>
                <ul>
                  {relatedServices(work.id).map((service) => (
                    <li>
                      <a href={service.href}>
                        {service.title}
                        <PurposeIcon name="arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="experience-case__links">
                {work.detailUrl && (
                  <a
                    class="purpose-text-link"
                    href={localizeHref(work.detailUrl)}
                    aria-label={`${work.title}: ${text.caseDetails}`}
                  >
                    {text.caseDetails}
                    <PurposeIcon name="arrow" />
                  </a>
                )}
                {work.externalUrl && (
                  <a
                    class="purpose-text-link"
                    href={localizeHref(work.externalUrl)}
                  >
                    {work.externalLabel}
                    <PurposeIcon name="arrow" />
                  </a>
                )}
                <a
                  class="purpose-text-link"
                  href={contactHref(work)}
                  aria-label={`${work.title}: ${text.discussThis}`}
                >
                  {text.discussThis}
                  <PurposeIcon name="arrow" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <PurposeCallout locale={locale} ctaId="works-cta-title" />
</BaseLayout>
<script>
  const filters =
    document.querySelectorAll<HTMLAnchorElement>("[data-work-filter]");
  const cases = document.querySelectorAll<HTMLElement>("[data-case-purpose]");
  const applyWorkFilter = () => {
    const purpose =
      new URLSearchParams(location.search).get("purpose") ?? "all";
    let current = [...filters].some(
      (link) => link.dataset.workFilter === purpose,
    )
      ? purpose
      : "all";
    let target: HTMLElement | null = null;
    try {
      target = document.getElementById(
        decodeURIComponent(location.hash.slice(1)),
      );
    } catch {
      /* Invalid fragments keep all cases available. */
    }
    if (
      target?.matches("[data-case-purpose]") ||
      target?.closest("[data-case-purpose]")
    )
      current = "all";
    for (const link of filters) {
      if (link.dataset.workFilter === current)
        link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
    for (const item of cases)
      item.hidden =
        current !== "all" &&
        !item.dataset.casePurpose?.split(" ").includes(current);
    const details = target?.closest("details");
    if (details instanceof HTMLDetailsElement) details.open = true;
  };
  for (const link of filters)
    link.addEventListener("click", (event) => {
      event.preventDefault();
      history.pushState(null, "", link.href);
      applyWorkFilter();
    });
  applyWorkFilter();
  window.addEventListener("popstate", applyWorkFilter);
  window.addEventListener("hashchange", applyWorkFilter);
</script>
