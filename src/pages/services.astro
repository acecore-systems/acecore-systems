---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnchorAliases from "../components/AnchorAliases.astro";
import PurposeIcon from "../components/PurposeIcon.astro";
import PurposeCallout from "../components/PurposeCallout.astro";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import { getServiceCatalog } from "../lib/service-catalog";
import site from "../data/site.json";
interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "ja";
const content = getLocalizedContent(locale);
const data = content.services;
const text = getUi(locale);
const groups = getServiceCatalog(content, locale);
const pricingByKey = new Map(
  content.pricing.items.map((item) => [item.key, item]),
);
const design = data.services.find((service) => service.id === "design")!;
const legacyAliases = (routeId: string, id: string) =>
  id !== routeId
    ? []
    : [
        ...data.services
          .filter(
            (service) =>
              service.detailUrl === `/services/${routeId}/` &&
              service.id !== id,
          )
          .map((service) => service.id),
        ...(routeId === "site-quality" ? ["site-functions"] : []),
        ...(routeId === "operations" ? ["operate", "operate-title"] : []),
      ];
---

<BaseLayout
  title={data.title}
  description={data.description}
  bodyClass="purpose-services purpose-selection-catalog"
  locale={locale}
>
  <section class="purpose-page-hero">
    <div class="container">
      <p class="purpose-eyebrow">{text.services}</p>
      <h1>{data.heroTitle}</h1>
      <p>{data.heroLead}</p>
    </div>
  </section>
  <section class="purpose-catalog" aria-label={text.services}>
    <div class="container purpose-catalog__layout">
      <nav class="purpose-category-rail" aria-label={text.services}>
        <a href="#all" data-service-category="all" aria-current="page">
          {text.purposeAll}
        </a>
        {groups.map((group) => (
          <a href={"#" + group.id} data-service-category={group.id}>
            {group.title}
          </a>
        ))}
      </nav>
      <div class="purpose-catalog__groups" id="all">
        <AnchorAliases
          ids={[
            "service-entry-title",
            "service-domains-title",
            "service-detail-index-title",
            "service-detail-primary-title",
            "service-detail-supporting-title",
          ]}
        />
        <p class="purpose-catalog__price-note">{content.pricing.heroLead}</p>
        <p>
          <a
            class="purpose-text-link"
            href={getLocalizedUrl("/pricing/", locale)}
          >
            {text.pricingCheck}
            <PurposeIcon name="arrow" />
          </a>
        </p>
        {groups.map((group) => (
          <section
            class="purpose-catalog-group"
            id={group.id}
            data-service-group={group.id}
            aria-labelledby={group.id + "-title"}
          >
            <header>
              <>
                <h2 id={group.id + "-title"}>{group.title}</h2>
                <p>{group.lead}</p>
              </>
            </header>
            <div class="purpose-service-rows">
              {group.items.map((item) => (
                <a
                  class="purpose-service-row"
                  id={item.id}
                  href={getLocalizedUrl(item.href, locale)}
                >
                  <PurposeIcon name={item.icon} />
                  <div class="purpose-service-row__content">
                    {[
                      ...(item.id === "development" ||
                      item.id === "it-advisor" ||
                      item.id === "website"
                        ? ["service-entry-" + item.id]
                        : []),
                      ...legacyAliases(item.routeId, item.id),
                    ].map((id) => (
                      <span
                        id={id}
                        class="purpose-anchor-alias"
                        aria-hidden="true"
                      />
                    ))}
                    <div class="purpose-service-row__intro">
                      <h3>{item.data.title}</h3>
                      <p class="purpose-service-row__summary">
                        {item.data.indexSummary}
                      </p>
                    </div>
                    <dl class="purpose-service-facts">
                      <div>
                        <dt>{text.serviceFor}</dt>
                        <dd>{item.data.challenges[0].title}</dd>
                      </div>
                      <div>
                        <dt>{text.serviceDeliverables}</dt>
                        <dd>{item.data.indexTopics.join(" / ")}</dd>
                      </div>
                      <div>
                        <dt>{text.pricing}</dt>
                        <dd class="purpose-service-facts__prices">
                          {item.pricingKeys.map((key) => {
                            const price = pricingByKey.get(key)!;
                            return (
                              <span>
                                <span>{price.label}</span>
                                <strong>{price.price}</strong>
                              </span>
                            );
                          })}
                        </dd>
                      </div>
                    </dl>
                  </div>
                  <PurposeIcon name="chevron" />
                </a>
              ))}
            </div>
            {group.id === "web" && (
              <p>
                <a
                  class="purpose-text-link"
                  href={getLocalizedUrl("/services/site-functions/", locale)}
                >
                  {content.serviceDetails.siteFunctions.title}
                  <PurposeIcon name="arrow" />
                </a>
              </p>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
  <section
    class="page-section purpose-design-supplement"
    id="design"
    aria-labelledby="design-title"
  >
    <div class="container">
      <details class="purpose-disclosure">
        <summary>
          <h2 id="design-title">{design.title}</h2>
          <PurposeIcon name="chevron" />
        </summary>
        <div class="purpose-disclosure__body">
          <p>{design.body}</p>
          <ul class="service-points">
            {design.examples.map((example) => (
              <li>{example}</li>
            ))}
          </ul>
          <p>{data.designContextNote}</p>
          <a
            class="purpose-text-link"
            href={
              site.acecoreUrl +
              getLocalizedUrl("/services/", locale) +
              "#design"
            }
          >
            {data.designContextLinkLabel}
            <PurposeIcon name="arrow" />
          </a>
        </div>
      </details>
    </div>
  </section>
  <section
    class="page-section page-section--muted"
    aria-labelledby="service-process-title"
  >
    <div class="container">
      <header class="editorial-header">
        <h2 id="service-process-title">{text.processTitle}</h2>
        <p>{text.processLead}</p>
      </header>
      <ol class="selection-process selection-process--four">
        {data.process.map((step, index) => (
          <li class="service-process__step">
            <>
              <p class="editorial-index">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div class="service-process__content">
                <>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </>
              </div>
            </>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <PurposeCallout locale={locale} ctaId="service-cta-title" />
</BaseLayout>
<script>
  const catalog = document.querySelector<HTMLElement>(".purpose-catalog");
  if (catalog) {
    const links = catalog.querySelectorAll<HTMLAnchorElement>(
      "[data-service-category]",
    );
    const groups = catalog.querySelectorAll<HTMLElement>(
      "[data-service-group]",
    );
    const selectCategory = (category: string) => {
      const current = [...links].some(
        (link) => link.dataset.serviceCategory === category,
      )
        ? category
        : "all";
      for (const link of links) {
        if (link.dataset.serviceCategory === current)
          link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
      for (const group of groups)
        group.hidden =
          current !== "all" && group.dataset.serviceGroup !== current;
      const target = document.getElementById(category);
      const disclosure =
        target?.closest("details") ?? target?.querySelector("details");
      if (disclosure instanceof HTMLDetailsElement) disclosure.open = true;
    };
    for (const link of links)
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const category = link.dataset.serviceCategory ?? "all";
        history.pushState(null, "", "#" + category);
        selectCategory(category);
      });
    window.addEventListener("hashchange", () =>
      selectCategory(location.hash.slice(1)),
    );
    window.addEventListener("popstate", () =>
      selectCategory(location.hash.slice(1)),
    );
    selectCategory(location.hash.slice(1));
  }
</script>
