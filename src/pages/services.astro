---
import BaseLayout from "../layouts/BaseLayout.astro";
import PurposeIcon from "../components/PurposeIcon.astro";
import PurposeCallout from "../components/PurposeCallout.astro";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import { getServiceCatalog } from "../lib/service-catalog";
import site from "../data/site.json";
interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "ja";
const content = getLocalizedContent(locale);
const data = content.services;
const text = getUi(locale);
const groups = getServiceCatalog(content, locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
---

<BaseLayout
  title={data.title}
  description={data.description}
  bodyClass="purpose-services"
  locale={locale}
>
  <section class="purpose-page-hero">
    <div class="container"><h1>{data.heroTitle}</h1><p>{data.heroLead}</p></div>
  </section>
  <section class="purpose-catalog" aria-label={text.services}>
    <div class="container purpose-catalog__layout">
      <nav class="purpose-category-rail" aria-label={text.services}>
        <a href="#all" data-service-category="all" aria-current="page"
          >{text.purposeAll}</a
        >
        {
          groups.map((group) => (
            <a href={"#" + group.id} data-service-category={group.id}>
              {group.title}
            </a>
          ))
        }
      </nav>
      <div class="purpose-catalog__groups" id="all">
        {
          groups.map((group) => (
            <section
              class="purpose-catalog-group"
              id={group.id}
              data-service-group={group.id}
              aria-labelledby={group.id + "-title"}
            >
              <header>
                <>
                  <h2 id={group.id + "-title"}>{group.title}</h2>
                  <p>{group.lead}</p>
                </>
              </header>
              <div class="purpose-service-rows">
                {group.items.map((item) => (
                  <a
                    class="purpose-service-row"
                    href={getLocalizedUrl(item.href, locale)}
                  >
                    <PurposeIcon name={item.icon} />
                    <div>
                      <h3>{item.data.title}</h3>
                      <p>{item.data.indexSummary}</p>
                    </div>
                    <PurposeIcon name="chevron" />
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
  <PurposeCallout locale={locale} />
  <section
    class="page-section purpose-detailed-scope"
    aria-labelledby="service-domains-title"
  >
    <div class="container">
      <header class="editorial-header">
        <h2 id="service-domains-title">{text.serviceDomainsTitle}</h2>
      </header>
      <div class="service-list">
        {
          data.services.map((service, index) => (
            <article class="service-row" id={service.id}>
              <header class="service-row__header">
                <>
                  <p class="editorial-index">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3>{service.title}</h3>
                </>
              </header>
              <div class="service-row__body">
                <p class="service-row__description">{service.body}</p>
                <ul class="service-points">
                  {service.examples.map((example) => (
                    <li>{example}</li>
                  ))}
                </ul>
                {service.id === "design" && (
                  <>
                    <p class="service-row__description">
                      {data.designContextNote}
                    </p>
                    <a
                      class="service-row__detail"
                      href={
                        site.acecoreUrl +
                        getLocalizedUrl("/services/", locale) +
                        "#design"
                      }
                    >
                      {data.designContextLinkLabel}
                    </a>
                  </>
                )}
                {service.detailUrl && (
                  <a
                    class="service-row__detail"
                    href={localizeHref(service.detailUrl)}
                  >
                    {text.viewSupportDetails}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="page-section page-section--muted"
    aria-labelledby="service-process-title"
  >
    <div class="container">
      <header class="editorial-header">
        <h2 id="service-process-title">{text.processTitle}</h2><p>
          {text.processLead}
        </p>
      </header>
      <ol class="service-process">
        {
          data.process.map((step, index) => (
            <li class="service-process__step">
              <>
                <p class="editorial-index">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <div class="service-process__content">
                  <>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
<script>
  const catalog = document.querySelector<HTMLElement>(".purpose-catalog");
  if (catalog) {
    const links = catalog.querySelectorAll<HTMLAnchorElement>(
      "[data-service-category]",
    );
    const groups = catalog.querySelectorAll<HTMLElement>(
      "[data-service-group]",
    );
    const selectCategory = (category: string) => {
      const current = [...links].some(
        (link) => link.dataset.serviceCategory === category,
      )
        ? category
        : "all";
      for (const link of links) {
        if (link.dataset.serviceCategory === current)
          link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
      for (const group of groups)
        group.hidden =
          current !== "all" && group.dataset.serviceGroup !== current;
    };
    for (const link of links)
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const category = link.dataset.serviceCategory ?? "all";
        history.pushState(null, "", "#" + category);
        selectCategory(category);
      });
    window.addEventListener("hashchange", () =>
      selectCategory(location.hash.slice(1)),
    );
    window.addEventListener("popstate", () =>
      selectCategory(location.hash.slice(1)),
    );
    selectCategory(location.hash.slice(1));
  }
</script>
