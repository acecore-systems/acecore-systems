---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/pricing.json'
---

<BaseLayout title={data.title} description={data.description}>
  <section class="page-hero page-hero--pricing">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">Engagement / 費用の目安</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section class="page-section page-section--pricing" aria-labelledby="price-list-title">
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Reference / 01</p>
          <h2 id="price-list-title">支援内容と料金</h2>
        </div>
        <p class="price-list__caption">内容と費用の目安</p>
      </header>
      <ol class="price-list">
        {
          data.items.map((item, index) => (
            <li class="price-row">
              <div class="price-row__heading">
                <p class="editorial-index">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3>{item.label}</h3>
              </div>
              <p class="price-row__note">{item.note}</p>
              <p class="price-row__amount">{item.price}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside class="editorial-cta price-cta" aria-labelledby="price-cta-title">
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Estimate</p>
          <h2 id="price-cta-title">正式な金額は要件整理後に見積ります。</h2>
          <p>目的、希望時期、現在の課題、予算感があればフォームに記入してください。</p>
        </div>
        <a class="editorial-link editorial-link--primary" href="/contact/">見積りを相談する</a>
      </aside>
    </div>
  </section>
</BaseLayout>
