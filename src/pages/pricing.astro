---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, htmlLangMap, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const content = getLocalizedContent(locale);
const data = content.pricing;
const development = content.serviceDetails.development;
const itAdvisor = content.itAdvisor;
const text = getUi(locale);
const canonicalPath = getLocalizedUrl("/pricing/", locale);
const pageUrl = new URL(canonicalPath, site.siteUrl).href;
const itemListId = `${pageUrl}#item-list`;
const tracks = [
  {
    id: "development",
    title: development.title,
    ctaLabel: development.ctaTitle,
    contactHref: `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams(
      {
        category: "service",
        service: "business-system",
        from: "systems-pricing",
        entry: "pricing-development-cta",
      },
    ).toString()}`,
  },
  {
    id: "it-advisor",
    title: itAdvisor.title,
    ctaLabel: itAdvisor.ctaLabel,
    contactHref: `${getLocalizedUrl("/contact/", locale)}?${new URLSearchParams(
      {
        category: "service",
        service: "it-advisor",
        from: "systems-pricing",
        entry: "pricing-it-advisor-cta",
      },
    ).toString()}`,
  },
] as const;
const priceTracks = tracks.map((track) => ({
  ...track,
  items: data.items
    .map((item, index) => ({ ...item, index }))
    .filter((item) => item.track === track.id),
}));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#collection`,
    name: data.title,
    url: pageUrl,
    description: data.description,
    inLanguage: htmlLangMap[locale],
    mainEntity: { "@id": itemListId },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": itemListId,
    itemListElement: data.items.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      url: new URL(getLocalizedUrl(item.detailUrl, locale), site.siteUrl).href,
    })),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={itemListId}
  locale={locale}
>
  <section class="page-hero page-hero--pricing">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">{text.pricingEyebrow}</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section
    class="page-section page-section--pricing"
    aria-labelledby="price-list-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Reference / 01</p>
          <h2 id="price-list-title">{text.priceListTitle}</h2>
        </div>
        <p class="price-list__caption">{text.priceListCaption}</p>
      </header>
      <div class="price-tracks">
        {
          priceTracks.map((track) => (
            <section
              class="price-track"
              aria-labelledby={`price-track-${track.id}`}
            >
              <header class="price-track__header">
                <p class="editorial-eyebrow">{track.id}</p>
                <h3 id={`price-track-${track.id}`}>{track.title}</h3>
              </header>
              <ol class="price-list">
                {track.items.map((item) => (
                  <li class="price-row" id={item.key}>
                    <div class="price-row__heading">
                      <p class="editorial-index">
                        {String(item.index + 1).padStart(2, "0")}
                      </p>
                      <h4>{item.label}</h4>
                    </div>
                    <div class="price-row__body">
                      <p class="price-row__note">{item.note}</p>
                      {item.detailUrl && (
                        <a
                          class="price-row__detail"
                          href={getLocalizedUrl(item.detailUrl, locale)}
                        >
                          {text.viewSupportDetails}
                        </a>
                      )}
                    </div>
                    <p class="price-row__amount">{item.price}</p>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside class="editorial-cta price-cta" aria-labelledby="price-cta-title">
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Estimate</p>
          <h2 id="price-cta-title">{text.estimateTitle}</h2>
          <p>{text.estimateBody}</p>
        </div>
        <div class="price-cta__actions">
          {
            priceTracks.map((track) => (
              <a
                class="editorial-link editorial-link--primary"
                href={track.contactHref}
              >
                {track.ctaLabel}
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @layer theme, base, components, utilities;
  @layer components {
    .price-tracks {
      display: grid;
      gap: clamp(48px, 7vw, 88px);
    }

    .price-track__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 24px;
      border-top: 1px solid var(--line-strong);
      padding-block: 18px;
    }

    .price-track__header h3 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.35rem, 2vw, 1.8rem);
    }

    .price-row__heading h4 {
      margin: 0;
      font-family: var(--font-sans);
      font-size: 1.35rem;
      font-weight: 500;
      line-height: 1.5;
    }

    @media (max-width: 640px) {
      .price-track__header {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }
    }
  }
</style>
