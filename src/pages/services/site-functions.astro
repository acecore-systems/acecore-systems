---
import ServiceDetailPage from "../../components/ServiceDetailPage.astro";
import { getLocalizedContent } from "../../i18n/content";
import type { Locale } from "../../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).serviceDetails.siteFunctions;
---

<ServiceDetailPage
  data={data}
  canonicalPath="/services/site-functions/"
  serviceKey="site-functions"
  consultationServiceKey="business-system"
  locale={locale}
/>
