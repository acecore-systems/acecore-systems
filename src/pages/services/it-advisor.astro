---
import ServiceDetailPage from "../../components/ServiceDetailPage.astro";
import { getLocalizedContent } from "../../i18n/content";
import type { Locale } from "../../i18n";
interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "ja";
---

<ServiceDetailPage
  data={getLocalizedContent(locale).itAdvisor}
  canonicalPath="/services/it-advisor/"
  serviceKey="it-advisor"
  locale={locale}
/>
