---
import ServiceDetailPage from "../../components/ServiceDetailPage.astro";
import { getLocalizedContent } from "../../i18n/content";
import type { Locale } from "../../i18n";

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).serviceDetails.website;
---

<ServiceDetailPage
  data={data}
  canonicalPath="/services/website/"
  serviceKey="website"
  consultationServiceKey="website"
  locale={locale}
/>
