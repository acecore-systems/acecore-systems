---
import { getCollection, render, type CollectionEntry } from 'astro:content'

import BaseLayout from '../../layouts/BaseLayout.astro'
import InsightFeatureBlocks from '../../components/InsightFeatureBlocks.astro'
import site from '../../data/site.json'
import { getInsightSlug } from '../../lib/insight-links.mjs'
import '../../styles/insights.css'

interface Props {
  entry: CollectionEntry<'insights'>
  author?: CollectionEntry<'authors'>['data']
}

export async function getStaticPaths() {
  const [insights, authors] = await Promise.all([
    getCollection('insights'),
    getCollection('authors'),
  ])
  const authorById = new Map(authors.map((author) => [author.id, author.data]))

  return insights.map((entry) => ({
    params: { slug: getInsightSlug(entry.id) },
    props: {
      entry,
      author: authorById.get(entry.data.author),
    },
  }))
}

const { entry, author } = Astro.props
const { Content, headings } = await render(entry)
const slug = getInsightSlug(entry.id)
const canonicalPath = `/insights/${slug}/`
const pageUrl = new URL(canonicalPath, site.siteUrl).href
const articleEntityId = `${pageUrl}#article`
const organizationId = `${new URL('/', site.acecoreUrl).href}#organization`
const systemsServiceId = `${new URL('/', site.siteUrl).href}#service`
const webPageId = `${pageUrl}#webpage`
const articleImage = entry.data.uploadedImage ?? entry.data.image
const articleImageUrl = articleImage
  ? new URL(articleImage, site.siteUrl).href
  : undefined
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
)
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': articleEntityId,
    headline: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    mainEntityOfPage: { '@id': webPageId },
    datePublished: entry.data.date.toISOString(),
    dateModified: (entry.data.lastUpdated ?? entry.data.date).toISOString(),
    inLanguage: 'ja',
    author: {
      '@type': 'Person',
      name: author?.name ?? entry.data.author,
      ...(author?.url ? { url: author.url } : {}),
    },
    publisher: { '@id': organizationId },
    about: { '@id': systemsServiceId },
    ...(articleImageUrl ? { image: articleImageUrl } : {}),
    keywords: entry.data.tags?.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'ホーム',
        item: new URL('/', site.siteUrl).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '技術解説',
        item: new URL('/insights/', site.siteUrl).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: entry.data.title,
        item: pageUrl,
      },
    ],
  },
  ...(entry.data.faq
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          '@id': `${pageUrl}#faq`,
          mainEntity: entry.data.faq.items.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: item.answer,
            },
          })),
        },
      ]
    : []),
]
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalPath}
  jsonLd={jsonLd}
  mainEntityId={articleEntityId}
  bodyClass="insight-article-page"
  ogType="article"
  image={articleImage}
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={(entry.data.lastUpdated ?? entry.data.date).toISOString()}
>
  <article class="insight-article">
    <header class="insight-article__header">
      <div class="container insight-article__header-inner">
        <nav class="breadcrumb" aria-label="パンくず">
          <ol>
            <li><a href="/">ホーム</a></li>
            <li><a href="/insights/">技術解説</a></li>
            <li aria-current="page">{entry.data.title}</li>
          </ol>
        </nav>
        <p class="page-eyebrow">Insights / 技術解説</p>
        <h1>{entry.data.title}</h1>
        <p class="insight-article__description">{entry.data.description}</p>
        <div class="insight-article__meta">
          <span>{author?.name ?? entry.data.author}</span>
          <time datetime={entry.data.date.toISOString()}>
            公開 {formatDate(entry.data.date)}
          </time>
          {
            entry.data.lastUpdated && (
              <time datetime={entry.data.lastUpdated.toISOString()}>
                更新 {formatDate(entry.data.lastUpdated)}
              </time>
            )
          }
        </div>
        {
          entry.data.tags && (
            <ul class="insight-tags" aria-label="タグ">
              {entry.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        {
          articleImage && (
            <figure class="insight-article__cover" aria-hidden="true">
              <img
                src={articleImage}
                alt=""
                width="1600"
                height="900"
                decoding="async"
                fetchpriority="high"
              />
            </figure>
          )
        }
      </div>
    </header>

    <div class="container insight-article__layout">
      <div class="insight-article__main">
        <InsightFeatureBlocks
          callout={entry.data.callout}
          insightGrid={entry.data.insightGrid}
          placement="before"
        />

        {
          tocHeadings.length > 0 && (
            <details class="insight-toc">
              <summary>この記事の目次</summary>
              <ol>
                {tocHeadings.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <div class="insight-prose">
          <Content />
        </div>

        <InsightFeatureBlocks
          processFigure={entry.data.processFigure}
          compareTable={entry.data.compareTable}
          checklist={entry.data.checklist}
          statBar={entry.data.statBar}
          linkCards={entry.data.linkCards}
          faq={entry.data.faq}
          placement="after"
        />

        {
          author && (
            <aside
              class="insight-author"
              aria-labelledby="insight-author-title"
            >
              <p class="editorial-eyebrow">Author</p>
              <h2 id="insight-author-title">{author.name}</h2>
              {author.bio && <p>{author.bio}</p>}
              {author.url && <a href={author.url}>プロフィールを見る</a>}
            </aside>
          )
        }
      </div>
    </div>
  </article>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside class="editorial-cta" aria-labelledby="article-cta-title">
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Next step</p>
          <h2 id="article-cta-title">実装前の整理から相談できます。</h2>
          <p>
            現在の構成、追加したい機能、運用上の制約を確認し、必要な範囲と進め方を整理します。
          </p>
        </div>
        <div>
          <a class="editorial-link" href="/guide/">導入ガイドを見る</a>
          <a
            class="editorial-link editorial-link--primary"
            href={`/contact/?category=service&from=systems-insight&entry=${slug}`}
          >
            技術相談をする
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
