---
import { getCollection, type CollectionEntry } from "astro:content";

import InsightArticlePage from "../../components/InsightArticlePage.astro";
import { getInsightLocale, getInsightSlug } from "../../lib/insight-links.mjs";

interface Props {
  entry: CollectionEntry<"insights">;
  author?: CollectionEntry<"authors">["data"];
}

export async function getStaticPaths() {
  const [insights, authors] = await Promise.all([
    getCollection("insights"),
    getCollection("authors"),
  ]);
  const authorById = new Map(authors.map((author) => [author.id, author.data]));

  return insights
    .filter((entry) => getInsightLocale(entry.id) === "ja")
    .map((entry) => ({
      params: { slug: getInsightSlug(entry.id) },
      props: {
        entry,
        author: authorById.get(entry.data.author),
      },
    }));
}

const { entry, author } = Astro.props;
---

<InsightArticlePage entry={entry} author={author} locale="ja" />
