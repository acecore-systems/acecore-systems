---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).privacy;
const text = getUi(locale);
---

<BaseLayout title={data.title} description={data.description} locale={locale}>
  <section class="page-hero page-hero--privacy">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">{text.privacyEyebrow}</p>
      <h1 class="page-title">{data.title}</h1>
      <p class="page-lead">{data.description}</p>
    </div>
  </section>

  <section
    class="page-section page-section--privacy"
    aria-labelledby="privacy-sections-title"
  >
    <div class="container page-narrow">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Principles / 01</p>
        <h2 id="privacy-sections-title">{text.privacyHandlingTitle}</h2>
      </header>
      <div class="editorial-list">
        {
          data.sections.map((section, index) => (
            <article class="editorial-row">
              <header class="editorial-row__header">
                <p class="editorial-index">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3>{section.title}</h3>
              </header>
              <div class="editorial-row__body">
                <p>{section.body}</p>
                {index === data.sections.length - 1 && (
                  <a
                    class="editorial-link"
                    href={getLocalizedUrl("/contact/", locale)}
                  >
                    {text.contactFormLink}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
