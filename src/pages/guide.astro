---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceVisual from "../components/ServiceVisual.astro";
import data from "../data/guide.json";
---

<BaseLayout title={data.title} description={data.description}>
  <section class="page-hero page-hero--guide">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">Field notes / 導入ガイド</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section class="guide-visual-section" aria-label="導入範囲を整理する様子">
    <div class="container">
      <ServiceVisual {...data.visual} variant="section" />
    </div>
  </section>

  <section
    class="page-section page-section--guide"
    aria-labelledby="guide-intro-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Perspective / 01</p>
        <h2 id="guide-intro-title">{data.introTitle}</h2>
        <p>{data.introBody}</p>
      </header>
      <ol class="guide-perspectives">
        {
          data.insights.map((item, index) => (
            <li class="guide-perspective">
              <p class="editorial-index">
                View {String(index + 1).padStart(2, "0")}
              </p>
              <div class="guide-perspective__content">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="page-section page-section--guide-journey"
    aria-labelledby="guide-journey-title"
  >
    <div class="container">
      <header class="editorial-header editorial-header--split">
        <div>
          <p class="editorial-eyebrow">Path / 02</p>
          <h2 id="guide-journey-title">{data.journeyTitle}</h2>
        </div>
        <p>{data.journeyLead}</p>
      </header>
      <ol class="guide-journey">
        {
          data.journey.map((step, index) => (
            <li class="guide-journey__step">
              <p class="editorial-index">
                Step {String(index + 1).padStart(2, "0")}
              </p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="page-section page-section--muted"
    aria-labelledby="guide-tips-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Checklist / 03</p>
        <h2 id="guide-tips-title">{data.tipsTitle}</h2>
        <p>{data.tipsLead}</p>
      </header>
      <ol class="guide-checklist">
        {
          data.tips.map((tip, index) => (
            <li class="guide-checkpoint">
              <header class="guide-checkpoint__header">
                <p class="editorial-index">
                  Point {String(index + 1).padStart(2, "0")}
                </p>
                <h3>{tip.title}</h3>
              </header>
              <div class="guide-checkpoint__body">
                <p>{tip.body}</p>
                <ul class="guide-checkpoint__points">
                  {tip.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="page-section page-section--guide-faq"
    aria-labelledby="guide-faq-title"
  >
    <div class="container">
      <header class="editorial-header">
        <p class="editorial-eyebrow">Questions / 04</p>
        <h2 id="guide-faq-title">{data.faqTitle}</h2>
      </header>
      <div class="guide-faq">
        {
          data.faqs.map((item, index) => (
            <details class="guide-faq__item">
              <summary>
                <span class="editorial-index">
                  Q{String(index + 1).padStart(2, "0")}
                </span>
                <span>{item.question}</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section page-section--cta">
    <div class="container">
      <aside class="editorial-cta guide-cta" aria-labelledby="guide-cta-title">
        <div class="editorial-cta__copy">
          <p class="editorial-eyebrow">Consultation</p>
          <h2 id="guide-cta-title">{data.ctaTitle}</h2>
          <p>{data.ctaBody}</p>
        </div>
        <a class="editorial-link editorial-link--primary" href="/contact/"
          >{data.ctaLabel}</a
        >
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-visual-section {
    padding-block: clamp(20px, 4vw, 44px) 0;
  }

  .guide-journey {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    list-style: none;
  }

  .guide-journey__step {
    position: relative;
    min-height: 240px;
    border-right: 1px solid var(--line);
    padding: clamp(24px, 3vw, 36px);
  }

  .guide-journey__step:last-child {
    border-right: 0;
  }

  .guide-journey__step:not(:last-child)::after {
    position: absolute;
    z-index: 1;
    top: 38px;
    right: -13px;
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--blue);
    content: "→";
    font-size: 0.78rem;
  }

  .guide-journey__step h3 {
    margin-top: clamp(42px, 5vw, 68px);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .guide-journey__step > p:last-child {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  @media (max-width: 860px) {
    .guide-journey {
      grid-template-columns: 1fr;
    }

    .guide-journey__step {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .guide-journey__step:last-child {
      border-bottom: 0;
    }

    .guide-journey__step:not(:last-child)::after {
      top: auto;
      right: 24px;
      bottom: -13px;
      content: "↓";
    }

    .guide-journey__step h3 {
      margin-top: 28px;
    }
  }
</style>
