---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import { getLocalizedContent } from "../i18n/content";
import { htmlLangMap, type Locale } from "../i18n";
import { getContactFormText } from "../i18n/contact-form";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).contact;
const formText = getContactFormText(locale);
---

<BaseLayout title={data.title} description={data.description} locale={locale}>
  <section class="page-hero page-hero--contact">
    <div class="container page-hero__inner">
      <p class="page-eyebrow">{formText.eyebrow}</p>
      <h1 class="page-title">{data.heroTitle}</h1>
      <p class="page-lead">{data.heroLead}</p>
    </div>
  </section>

  <section
    class="page-section page-section--contact"
    aria-labelledby="contact-form-title"
  >
    <div class="container contact-layout">
      <aside class="contact-intro">
        <header class="editorial-header">
          <p class="editorial-eyebrow">Contact form / 01</p>
          <h2 id="contact-form-title">{formText.formTitle}</h2>
          <p>{data.formLead}</p>
        </header>
        <div class="contact-faq" aria-label={formText.faqLabel}>
          {
            data.faqs.map((faq, index) => (
              <details class="contact-faq__item">
                <summary>
                  <span class="editorial-index">
                    Q{String(index + 1).padStart(2, "0")}
                  </span>
                  <span>{faq.question}</span>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </aside>
      <form
        id="contact-form"
        class="contact-form"
        action={site.contactFormAction}
        method="post"
        data-consultation-suffix={formText.consultationSuffix}
        data-submitting-text={formText.submitting}
      >
        <input type="hidden" name="locale" value={locale} />
        <input type="hidden" name="submission_id" value="" />
        <input type="hidden" name="source" value="systems.acecore.net" />
        <input id="contact-service" type="hidden" name="service" value="" />
        <input id="contact-from" type="hidden" name="from" value="" />
        <input id="contact-entry" type="hidden" name="entry" value="" />
        <div class="contact-honeypot" aria-hidden="true">
          <label for="company-website">{formText.companyWebsite}</label>
          <input
            id="company-website"
            name="company_website"
            autocomplete="off"
            tabindex="-1"
          />
        </div>
        <div class="contact-field">
          <label for="category"
            >{formText.category}
            <span class="field-required">{formText.required}</span></label
          >
          <select id="category" name="お問い合わせ種別" required>
            <option value="">{formText.select}</option>
            {
              formText.categoryOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))
            }
          </select>
        </div>
        <div class="contact-field">
          <label for="name"
            >{formText.name}
            <span class="field-required">{formText.required}</span></label
          >
          <input id="name" name="お名前" autocomplete="name" required />
        </div>
        <div class="contact-field">
          <label for="email"
            >{formText.email}
            <span class="field-required">{formText.required}</span></label
          >
          <input
            id="email"
            name="メールアドレス"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="contact-field">
          <label for="subject"
            >{formText.subject}
            <span class="field-required">{formText.required}</span></label
          >
          <input id="subject" name="件名" required />
        </div>
        <div class="contact-field">
          <label for="message"
            >{formText.message}
            <span class="field-required">{formText.required}</span></label
          >
          <textarea id="message" name="お問い合わせ内容" required></textarea>
        </div>
        <div
          id="turnstile-widget"
          class="cf-turnstile"
          data-sitekey={site.turnstileSiteKey}
          data-theme="light"
          data-language={htmlLangMap[locale]}
          data-action="systems-contact"
          data-cdata="acecore-systems"
        >
        </div>
        <p class="contact-form__note">
          {formText.submissionNote}
        </p>
        <p
          id="contact-form-status"
          class="contact-form__status"
          role="alert"
          hidden
        >
          {formText.validationError}
        </p>
        <button
          class="editorial-link editorial-link--primary contact-submit"
          type="submit"
        >
          {formText.submit}
        </button>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");

    if (form) {
      const submissionId = form.querySelector<HTMLInputElement>(
        'input[name="submission_id"]',
      );
      const retryStorageKey = "systems-contact-retry";
      const params = new URLSearchParams(window.location.search);
      const retryId = params.get("submission_id") || "";
      const validId = (value: string) =>
        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
          value,
        );
      let previous: { id: string; fingerprint: string } | null = null;
      try {
        const saved = JSON.parse(
          sessionStorage.getItem(retryStorageKey) || "null",
        );
        if (saved && validId(saved.id) && typeof saved.fingerprint === "string")
          previous = saved;
      } catch {
        // Private browsing can disable session storage; submission still works.
      }
      if (submissionId)
        submissionId.value = validId(retryId)
          ? retryId
          : previous?.id || crypto.randomUUID();
      window.addEventListener("pageshow", (event) => {
        if (!event.persisted || !submissionId) return;
        try {
          if (!sessionStorage.getItem(retryStorageKey))
            submissionId.value = crypto.randomUUID();
        } catch {
          // Without storage, the form keeps the ID already on the page.
        }
      });
      const status = form.querySelector<HTMLParagraphElement>(
        "#contact-form-status",
      );
      const submit = form.querySelector<HTMLButtonElement>(".contact-submit");
      const readParam = (name: string) =>
        (params.get(name) || "").trim().slice(0, 200);
      const serviceKey = readParam("service").toLowerCase();
      const categoryParam = readParam("category");
      const fromValue = readParam("from");
      const entryValue = readParam("entry");
      const serviceDetails: Record<string, { category: string }> = {
        "it-advisor": { category: "IT顧問・AI導入・デプロイについて" },
        "business-system": { category: "業務システム開発について" },
        system: { category: "業務システム開発について" },
        systems: { category: "業務システム開発について" },
        modernization: { category: "業務システム開発について" },
        "web-app": { category: "Webアプリ・管理画面について" },
        "site-functions": { category: "Webサイト機能・品質改善について" },
        "site-quality": { category: "Webサイト機能・品質改善について" },
        operations: { category: "保守・運用改善について" },
        web: { category: "Webアプリ・管理画面について" },
        website: { category: "Webアプリ・管理画面について" },
        integration: { category: "データ連携・自動化について" },
        automation: { category: "データ連携・自動化について" },
        data: { category: "データ連携・自動化について" },
        server: { category: "その他" },
        aceserver: { category: "その他" },
        design: { category: "デザイン・クリエイティブについて" },
        education: { category: "その他" },
        acestudio: { category: "その他" },
      };
      const categoryAliases: Record<string, string> = {
        service: "サービス全般について",
        "it-advisor": "IT顧問・AI導入・デプロイについて",
        "business-system": "業務システム開発について",
        system: "業務システム開発について",
        "web-app": "Webアプリ・管理画面について",
        web: "Webアプリ・管理画面について",
        "site-functions": "Webサイト機能・品質改善について",
        "site-quality": "Webサイト機能・品質改善について",
        design: "デザイン・クリエイティブについて",
        integration: "データ連携・自動化について",
        automation: "データ連携・自動化について",
        operations: "保守・運用改善について",
        estimate: "見積り相談",
        pricing: "見積り相談",
        quote: "見積り相談",
        other: "その他",
      };
      const service = serviceDetails[serviceKey];
      const category = form.querySelector<HTMLSelectElement>("#category");
      const subject = form.querySelector<HTMLInputElement>("#subject");
      const availableCategories = category
        ? Array.from(category.options, (option) => option.value)
        : [];
      const requestedCategory =
        (categoryParam === "service" && service?.category) ||
        categoryAliases[categoryParam.toLowerCase()] ||
        (availableCategories.includes(categoryParam) ? categoryParam : "") ||
        service?.category ||
        "";

      if (category && requestedCategory) {
        category.value = requestedCategory;
        category.dispatchEvent(new Event("change", { bubbles: true }));
      }

      if (subject && !subject.value.trim()) {
        const selectedLabel =
          category?.selectedOptions[0]?.textContent?.trim() || "";
        if (selectedLabel) {
          subject.value = `${selectedLabel} — ${form.dataset.consultationSuffix || ""}`;
        }
      }

      const serviceInput =
        form.querySelector<HTMLInputElement>("#contact-service");
      const fromInput = form.querySelector<HTMLInputElement>("#contact-from");
      const entryInput = form.querySelector<HTMLInputElement>("#contact-entry");

      if (serviceInput) serviceInput.value = serviceKey;
      if (fromInput) fromInput.value = fromValue;
      if (entryInput) entryInput.value = entryValue;

      form.addEventListener("submit", (event) => {
        const turnstileToken = form.querySelector<HTMLInputElement>(
          'input[name="cf-turnstile-response"]',
        )?.value;

        if (!turnstileToken) {
          event.preventDefault();
          form
            .querySelector<HTMLElement>("#turnstile-widget")
            ?.dispatchEvent(new Event("turnstile-reset"));
          if (status) status.hidden = false;
          return;
        }

        if (submissionId) {
          const fields = [
            "locale",
            "category",
            "name",
            "email",
            "subject",
            "message",
          ];
          const payload = JSON.stringify(
            fields.map(
              (name) =>
                (
                  form.elements.namedItem(name) as
                    | HTMLInputElement
                    | HTMLTextAreaElement
                    | HTMLSelectElement
                    | null
                )?.value || "",
            ),
          );
          // Store only a change detector, never the form's personal information.
          let hash = 0xcbf29ce484222325n;
          for (const byte of new TextEncoder().encode(payload)) {
            hash = BigInt.asUintN(64, (hash ^ BigInt(byte)) * 0x100000001b3n);
          }
          const fingerprint = hash.toString(16).padStart(16, "0");
          if (
            previous?.id === submissionId.value &&
            previous.fingerprint !== fingerprint
          )
            submissionId.value = crypto.randomUUID();
          previous = { id: submissionId.value, fingerprint };
          try {
            sessionStorage.setItem(retryStorageKey, JSON.stringify(previous));
          } catch {
            // The retry ID remains in the redirect URL when storage is unavailable.
          }
        }

        if (status) status.hidden = true;
        if (submit) {
          submit.disabled = true;
          submit.textContent = form.dataset.submittingText || "…";
        }
      });
    }
  </script>
  <script is:inline>
    function initSystemsContactTurnstile() {
      const turnstileEl = document.getElementById("turnstile-widget");
      if (!turnstileEl || turnstileEl.dataset.widgetId) return;

      const sitekey = turnstileEl.dataset.sitekey;
      const language = turnstileEl.dataset.language;
      const theme = turnstileEl.dataset.theme || "light";
      const action = turnstileEl.dataset.action;
      const cData = turnstileEl.dataset.cdata;

      if (!sitekey) return;

      function resetTurnstile() {
        const widgetId = turnstileEl.dataset.widgetId;
        if (typeof window.turnstile === "undefined" || !widgetId) return;

        window.turnstile.reset(widgetId);
      }

      turnstileEl.addEventListener("turnstile-reset", resetTurnstile);

      function renderTurnstile() {
        if (
          typeof window.turnstile === "undefined" ||
          turnstileEl.dataset.widgetId
        ) {
          return;
        }

        const widgetId = window.turnstile.render(turnstileEl, {
          sitekey,
          language,
          theme,
          action,
          cData,
          "expired-callback": resetTurnstile,
        });
        turnstileEl.dataset.widgetId = String(widgetId);
      }

      if (typeof window.turnstile !== "undefined") {
        renderTurnstile();
        return;
      }

      const existingScript = document.querySelector(
        "script[data-systems-turnstile-script]",
      );

      if (existingScript) {
        let attempts = 0;
        const waitForTurnstile = function () {
          if (typeof window.turnstile !== "undefined") {
            renderTurnstile();
            return;
          }
          if (attempts >= 50) return;
          attempts += 1;
          window.setTimeout(waitForTurnstile, 100);
        };
        waitForTurnstile();
        return;
      }

      const script = document.createElement("script");
      script.dataset.systemsTurnstileScript = "true";
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.addEventListener("load", renderTurnstile, { once: true });
      document.head.appendChild(script);
    }

    document.addEventListener("astro:page-load", initSystemsContactTurnstile);
    initSystemsContactTurnstile();
  </script>
</BaseLayout>
