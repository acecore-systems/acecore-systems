---
import WorkDetailPage from "../../components/WorkDetailPage.astro";
import { getLocalizedContent } from "../../i18n/content";
import type { Locale } from "../../i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const data = getLocalizedContent(locale).workDetail;
---

<WorkDetailPage
  data={data}
  canonicalPath="/works/acecore-site-platform/"
  locale={locale}
/>
