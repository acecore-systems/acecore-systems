---
import BaseLayout from "../layouts/BaseLayout.astro";
import PurposeIcon from "../components/PurposeIcon.astro";
import PurposeWork from "../components/PurposeWork.astro";
import PurposeCaseCards from "../components/PurposeCaseCards.astro";
import PurposeCallout from "../components/PurposeCallout.astro";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";
import site from "../data/site.json";
interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? "ja";
const { home, itAdvisor } = getLocalizedContent(locale);
const text = getUi(locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
const needs = [
  {
    title: text.purposeWebsiteNeed,
    body: home.layers[0].body,
    icon: "monitor" as const,
    href: getLocalizedUrl("/services/", locale) + "#web",
  },
  {
    title: text.purposeAutomationNeed,
    body: home.layers[1].body,
    icon: "settings" as const,
    href: getLocalizedUrl("/services/", locale) + "#work",
  },
  {
    title: text.purposeAdvisorNeed,
    body: itAdvisor.indexSummary,
    icon: "users" as const,
    href: getLocalizedUrl("/services/it-advisor/", locale),
  },
];
---

<BaseLayout
  title={home.title}
  description={home.description}
  image="/images/acecore-systems-og.webp"
  bodyClass="home-page purpose-home purpose-selection-home"
  locale={locale}
>
  <section class="purpose-home-hero">
    <div class="container purpose-split-hero">
      <div class="purpose-hero-copy">
        <p class="purpose-eyebrow">{home.heroEyebrow}</p>
        <h1>{home.heroTitle}</h1>
        <p class="purpose-home-hero__lead">{home.heroLead}</p>
        <div class="purpose-hero-actions">
          <a class="purpose-button" href={localizeHref(home.primaryCtaHref)}
            >{text.purposeViewServices}<PurposeIcon name="arrow" /></a
          >
          <a
            class="purpose-button purpose-button--secondary"
            href={getLocalizedUrl("/contact/", locale)}>{text.purposeContact}</a
          >
        </div>
      </div>
      <PurposeWork locale={locale} compact hero />
    </div>
  </section>
  <section class="purpose-needs" aria-label={home.consultationTitle}>
    <div class="container">
      <header class="purpose-section-heading">
        <h2>{text.chooseScopeTitle}</h2><a
          class="purpose-text-link"
          href={getLocalizedUrl("/services/", locale)}
          >{text.purposeViewServices}<PurposeIcon name="arrow" /></a
        >
      </header>
      <div class="purpose-needs__list">
        {
          needs.map((need) => (
            <a class="purpose-need" href={need.href}>
              <PurposeIcon name={need.icon} />
              <span>
                <>
                  <strong>{need.title}</strong>
                  <span class="purpose-need__description">{need.body}</span>
                </>
              </span>
              <PurposeIcon name="chevron" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="purpose-selected-work" aria-labelledby="home-work-title">
    <div class="container">
      <header class="purpose-section-heading">
        <div>
          <h2 id="home-work-title">{text.works}</h2><p>
            {text.selectedWorkLead}
          </p>
        </div>
        <a class="purpose-text-link" href={getLocalizedUrl("/works/", locale)}
          >{text.viewWorks}<PurposeIcon name="arrow" /></a
        >
      </header>
      <PurposeCaseCards locale={locale} />
    </div>
  </section>
  <section
    class="home-section home-philosophy"
    id="philosophy"
    aria-labelledby="philosophy-title"
  >
    <div class="container">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">{home.philosophyEyebrow}</p><h2
            id="philosophy-title"
          >
            {home.philosophyTitle}
          </h2>
        </div>
        <div>
          <p>{home.philosophyLead}</p><a
            class="editorial-link"
            href={site.acecoreUrl +
              getLocalizedUrl("/about/", locale) +
              "#corporate-philosophy-heading"}>{home.philosophyLinkLabel}</a
          >
        </div>
      </header>
      <ol class="principle-list">
        {
          home.designPrinciples.map((principle) => (
            <li class="principle-row">
              <>
                <p class="editorial-index">{principle.number}</p>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <PurposeCallout locale={locale} />
</BaseLayout>
