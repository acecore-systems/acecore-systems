---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedContent } from "../i18n/content";
import { getLocalizedUrl, type Locale } from "../i18n";
import { getUi } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "ja";
const { home, services, works } = getLocalizedContent(locale);
const text = getUi(locale);
const localizeHref = (href: string) =>
  href.startsWith("/") ? getLocalizedUrl(href, locale) : href;
---

<BaseLayout
  title={home.title}
  description={home.description}
  image="/images/acecore-systems-og.webp"
  bodyClass="home-page"
  locale={locale}
>
  <section class="home-hero">
    <div class="home-hero__surface" aria-hidden="true"></div>
    <div class="container home-hero__inner">
      <p class="home-eyebrow">{home.heroEyebrow}</p>
      <h1>{home.heroTitle}</h1>
      <p class="home-hero__lead">{home.heroLead}</p>
      <div class="home-actions">
        <a
          class="editorial-link editorial-link--primary"
          href={localizeHref(home.primaryCtaHref)}
        >
          {home.primaryCta}
        </a>
        <a class="editorial-link" href={localizeHref(home.secondaryCtaHref)}
          >{home.secondaryCta}</a
        >
      </div>
    </div>
  </section>

  <section class="layer-model" aria-labelledby="layer-model-title">
    <h2 class="visually-hidden" id="layer-model-title">{home.layersTitle}</h2>
    <p class="visually-hidden">{home.layersLead}</p>
    <figure class="layer-model__visual">
      <img
        src="/images/quiet-infrastructure-section-v2-exact.webp"
        alt=""
        width="1487"
        height="372"
        loading="eager"
        decoding="async"
      />
      <figcaption class="container layer-model__overlay">
        {
          home.layers.map((layer) => (
            <div class="layer-model__row">
              <p class="layer-model__label">{layer.label}</p>
              <p class="layer-model__body">{layer.body}</p>
            </div>
          ))
        }
      </figcaption>
    </figure>
    <div class="layer-model__summary" aria-label={text.layerSummary}>
      <div class="container layer-model__summary-inner">
        {home.layers.map((layer) => <p>{layer.title}</p>)}
      </div>
    </div>
  </section>

  <section
    class="home-section home-philosophy"
    id="philosophy"
    aria-labelledby="philosophy-title"
  >
    <div class="container">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">{home.philosophyEyebrow}</p>
          <h2 id="philosophy-title">{home.philosophyTitle}</h2>
        </div>
        <p>{home.philosophyLead}</p>
      </header>
      <ol class="principle-list">
        {
          home.designPrinciples.map((principle) => (
            <li class="principle-row">
              <p class="editorial-index">{principle.number}</p>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-section home-domains" aria-labelledby="domain-title">
    <div class="container">
      <header class="home-section__header">
        <p class="home-eyebrow">DESIGN DOMAINS</p>
        <h2 id="domain-title">{text.designDomainsTitle}</h2>
        <p>{text.designDomainsLead}</p>
      </header>
      <div class="domain-list">
        {
          services.services.map((service, index) => (
            <a
              class="domain-row"
              href={localizeHref(
                service.detailUrl || `/services/#${service.id}`,
              )}
            >
              <p class="editorial-index">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              <span>{text.viewDetails}</span>
            </a>
          ))
        }
      </div>
      <div class="home-section__foot">
        <a class="editorial-link" href={getLocalizedUrl("/services/", locale)}
          >{text.viewAllServices}</a
        >
      </div>
    </div>
  </section>

  <section
    class="home-section home-consultation"
    aria-labelledby="consultation-title"
  >
    <div class="container">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">{home.consultationEyebrow}</p>
          <h2 id="consultation-title">{home.consultationTitle}</h2>
        </div>
        <p>{home.consultationLead}</p>
      </header>
      <div class="consultation-list">
        {
          home.consultationSituations.map((situation, index) => (
            <a class="consultation-row" href={localizeHref(situation.href)}>
              <p class="editorial-index">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div>
                <h3>{situation.title}</h3>
                <p>{situation.body}</p>
              </div>
              <span>{text.viewConsultationEntry}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-section home-work" aria-labelledby="home-work-title">
    <div class="container">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">SELECTED WORK</p>
          <h2 id="home-work-title">{text.selectedWorkTitle}</h2>
        </div>
        <p>{text.selectedWorkLead}</p>
      </header>
      <div class="home-work__list">
        {
          works.cases.slice(0, 2).map((work, index) => (
            <article class="home-work__row">
              <p class="editorial-index">
                {String(index + 1).padStart(2, "0")}
              </p>
              <figure class="home-work__visual">
                <img
                  src={work.image}
                  alt={work.imageAlt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div>
                <p class="home-work__category">{work.category}</p>
                <h3>
                  {work.detailUrl ? (
                    <a
                      class="home-work__title-link"
                      href={localizeHref(work.detailUrl)}
                    >
                      {work.title}
                    </a>
                  ) : (
                    work.title
                  )}
                </h3>
              </div>
              <p>{work.summary}</p>
            </article>
          ))
        }
      </div>
      <div class="home-section__foot">
        <a class="editorial-link" href={getLocalizedUrl("/works/", locale)}
          >{text.viewWorks}</a
        >
      </div>
    </div>
  </section>

  <section class="home-section home-final-cta">
    <div class="container">
      <aside class="editorial-cta" aria-labelledby="home-cta-title">
        <div class="editorial-cta__copy">
          <p class="home-eyebrow">{home.ctaEyebrow}</p>
          <h2 id="home-cta-title">{home.ctaTitle}</h2>
          <p>{home.ctaBody}</p>
        </div>
        <a
          class="editorial-link editorial-link--primary"
          href={localizeHref(home.ctaHref)}
        >
          {home.ctaLabel}
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
