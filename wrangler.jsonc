{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acecore-systems",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-03-12",
  "vars": {
    "SEARCH_ENABLED": "true",
    "SEARCH_MIN_SCORE": "0.50",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
    "OPENAI_EMBEDDING_DIMENSIONS": "1536",
  },
  "env": {
    "preview": {
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "acecore-systems-search-openai-1536-preview",
          "remote": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-systems-search-preview",
          "database_id": "9346ee59-7cb7-4da1-9a00-7f75eee19f91",
          "migrations_dir": "./migrations/search",
        },
      ],
      "vars": {
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.50",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
        "OPENAI_EMBEDDING_DIMENSIONS": "1536",
      },
    },
    "production": {
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "acecore-systems-search-openai-1536-production",
        },
      ],
      "d1_databases": [
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-systems-search-production",
          "database_id": "ac8a06c2-deb4-4b27-9fbc-0fa2eef3c76d",
          "migrations_dir": "./migrations/search",
        },
      ],
      "vars": {
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.50",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
        "OPENAI_EMBEDDING_DIMENSIONS": "1536",
      },
    },
  },
}
